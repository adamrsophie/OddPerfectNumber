  [183041, 79, 151, 157, 241, 251, 311, 313, 421, 599, 661, 691, 701, 821, 881, 941, 1031, 1093, 1171, 1201, 1249, 1321, 1327, 1361, 1451, 1481, 1483, 1621, 1801, 1831, 1873, 1901, 1931, 2003, 2029, 2131, 2161, 2237, 2281, 2351, 2441, 2621, 2711, 2791, 2801, 2887, 2971, 3121, 3221, 3329, 3407, 3461, 3491, 3511, 3541, 3719, 4057, 4091, 4421, 4441, 4447, 4733, 4759, 4831, 5011, 5021, 5641, 5711, 5741, 5881, 6011, 6121, 6397, 6491, 6761, 6961, 7177, 7351, 7411, 7591, 8081, 8191, 8581, 8741, 8821, 9011, 9049, 9551, 9661, 9803, 9907, 10271, 10321, 10427, 10453, 10531, 10687, 10711, 10771, 10973, 11251, 11519, 11597, 11701, 12161, 12611, 12841, 13591, 13781, 14197, 14461, 14951, 15107, 15601, 15731, 15809, 15991, 16061, 16301, 16381]

/-- Nodes, part 4. -/
def nd65_4 : List ℕ :=
  [16831, 16901, 16921, 16979, 17191, 17291, 17351, 17471, 17551, 17681, 17863, 17971, 18521, 18539, 18541, 19891, 20021, 20359, 20593, 20731, 20879, 21061, 21139, 21191, 21347, 21529]
/-- Rows with their sources, part 0. -/
def zp65_0 : List (ℕ × List ℕ) := ((nodes65.zip rows65).drop 0).take 100

/-- Rows with their sources, part 1. -/
def zp65_1 : List (ℕ × List ℕ) := ((nodes65.zip rows65).drop 100).take 100

/-- Rows with their sources, part 2. -/
def zp65_2 : List (ℕ × List ℕ) := ((nodes65.zip rows65).drop 200).take 100

/-- Rows with their sources, part 3. -/
def zp65_3 : List (ℕ × List ℕ) := ((nodes65.zip rows65).drop 300).take 100

/-- The rows with their sources in parts. -/
theorem zp65_eq : nodes65.zip rows65 =
    [zp65_0, zp65_1, zp65_2, zp65_3].flatten := by
  decide +kernel

/-- The divisibility checks of the rows, part 0. -/
theorem rows65_0 : zp65_0.all (rowChk 65 nodes65) = true := by decide +kernel

/-- The divisibility checks of the rows, part 1. -/
theorem rows65_1 : zp65_1.all (rowChk 65 nodes65) = true := by decide +kernel

/-- The divisibility checks of the rows, part 2. -/
theorem rows65_2 : zp65_2.all (rowChk 65 nodes65) = true := by decide +kernel

/-- The divisibility checks of the rows, part 3. -/
theorem rows65_3 : zp65_3.all (rowChk 65 nodes65) = true := by decide +kernel

/-- The divisibility checks of all rows. -/
theorem hrows65 : ∀ e ∈ nodes65.zip rows65, rowChk 65 nodes65 e = true :=
  all_of_parts _ zp65_eq (by
    intro c hc
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl
    exacts [rows65_0, rows65_1, rows65_2, rows65_3])

/-- No node is `2`. -/
theorem nodes65_ne2 : ∀ t ∈ nodes65, t ≠ 2 := by
  have : nodes65.all (· != 2) = true := by decide +kernel
  intro t ht
  simpa using List.all_eq_true.mp this t ht

/-- The source nodes in parts. -/
theorem src65_eq : nodes65.take rows65.length =
    [src65_0, src65_1, src65_2, src65_3].flatten := by
  decide +kernel

/-- The nodes in parts. -/
theorem nd65_eq : nodes65 =
    [nd65_0, nd65_1, nd65_2, nd65_3, nd65_4].flatten := by
  decide +kernel

/-- The blocked candidates, branch A. -/
def cand65A (b : ℕ) : Bool := b == 13

/-- Reach checks for the blocked source nodes, part 0, branch A. -/
theorem reach65A_0 :
    src65_0.all (fun b => !cand65A b || reach nodes65 rows65 3 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 1, branch A. -/
theorem reach65A_1 :
    src65_1.all (fun b => !cand65A b || reach nodes65 rows65 3 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 2, branch A. -/
theorem reach65A_2 :
    src65_2.all (fun b => !cand65A b || reach nodes65 rows65 3 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 3, branch A. -/
theorem reach65A_3 :
    src65_3.all (fun b => !cand65A b || reach nodes65 rows65 3 tm65 2 b) = true := by
  decide +kernel

/-- Reach check with no source blocked, branch A. -/
theorem reach65A_none : reach nodes65 rows65 3 tm65 2 0 = true := by decide +kernel

/-- Every blocked source node passes the reach check, branch A. -/
theorem hcand65A : ∀ b ∈ nodes65.take rows65.length, cand65A b = true →
    reach nodes65 rows65 3 tm65 2 b = true := by
  intro b hb hcb
  have := all_of_parts (f := fun b => !cand65A b || reach nodes65 rows65 3 tm65 2 b)
    _ src65_eq (by
    intro c hc
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl
    exacts [reach65A_0, reach65A_1, reach65A_2, reach65A_3]) b hb
  simpa [hcb] using this

/-- The blocked candidates, branch B. -/
def cand65B (b : ℕ) : Bool := b % 12 == 1 && b != 13

/-- Reach checks for the blocked source nodes, part 0, branch B. -/
theorem reach65B_0 :
    src65_0.all (fun b => !cand65B b || reach nodes65 rows65 2 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 1, branch B. -/
theorem reach65B_1 :
    src65_1.all (fun b => !cand65B b || reach nodes65 rows65 2 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 2, branch B. -/
theorem reach65B_2 :
    src65_2.all (fun b => !cand65B b || reach nodes65 rows65 2 tm65 2 b) = true := by
  decide +kernel

/-- Reach checks for the blocked source nodes, part 3, branch B. -/
theorem reach65B_3 :
    src65_3.all (fun b => !cand65B b || reach nodes65 rows65 2 tm65 2 b) = true := by
  decide +kernel

/-- Reach check with no source blocked, branch B. -/
theorem reach65B_none : reach nodes65 rows65 2 tm65 2 0 = true := by decide +kernel

/-- Every blocked source node passes the reach check, branch B. -/
theorem hcand65B : ∀ b ∈ nodes65.take rows65.length, cand65B b = true →
    reach nodes65 rows65 2 tm65 2 b = true := by
  intro b hb hcb
  have := all_of_parts (f := fun b => !cand65B b || reach nodes65 rows65 2 tm65 2 b)
    _ src65_eq (by
    intro c hc
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl
    exacts [reach65B_0, reach65B_1, reach65B_2, reach65B_3]) b hb
  simpa [hcb] using this

/-- The nodes of part 0 are certified. -/
theorem nd65_0_isPS : nd65_0.all (isPS []) = true := by decide +kernel

/-- The nodes of part 1 are certified. -/
theorem nd65_1_isPS : nd65_1.all (isPS []) = true := by decide +kernel

/-- The nodes of part 2 are certified. -/
theorem nd65_2_isPS : nd65_2.all (isPS []) = true := by decide +kernel

/-- The nodes of part 3 are certified. -/
theorem nd65_3_isPS : nd65_3.all (isPS []) = true := by decide +kernel

/-- The nodes of part 4 are certified. -/
theorem nd65_4_isPS : nd65_4.all (isPS []) = true := by decide +kernel

/-- The nodes of the `d = 65` table are prime. -/
theorem nodes65_prime : ∀ t ∈ nodes65, t.Prime := fun t ht =>
  isPS_sound rfl (all_of_parts _ nd65_eq (by
    intro c hc
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl | rfl
    exacts [nd65_0_isPS, nd65_1_isPS, nd65_2_isPS, nd65_3_isPS, nd65_4_isPS]) t ht)

/-- The target primes are the nodes selected by the target mask. -/
theorem vals65_sel : CommonChain.sel 0 tm65 0 nodes65 = vals65 := by decide +kernel

/-- The target primes are distinct. -/
theorem vals65_nodup : vals65.Nodup :=
  (nodup_of_ndM (M := 0) (by decide +kernel)).1

/-- The two full products over the target primes. -/
theorem PG65 : pPow (expL vals65 0) = P65 ∧ pSig (expL vals65 0) = G65 := by
  decide +kernel

/-- Abundance: the target primes with fourth powers, and with any one of them `≡ 1 (mod 12)` to
the first power. -/
theorem ab65 : abOK2 vals65 (fun b : ℕ => b % 12 == 1) P65 G65 = true := by decide +kernel

end FamInst

open FamInst in
/-- The common `65` family is impossible (known; Evans and Pearlman 2007). Let `N` be an odd
perfect number with special prime `q`. Then `65 ∣ v_p(N) + 1` cannot hold for every ordinary
prime `p`. Here `5 ∣ N`, `13 ∣ N` and `q ≡ 1 (mod 12)`. If `q = 13`, then `7 ∣ 13 + 1` divides
`N` and the seeds are `5, 13, 7` with the rows of `13` blocked; otherwise `13` is ordinary, the
seeds are `5, 13`, and every source node `≡ 1 (mod 12)` other than `13` is blocked in turn. In
both cases the target primes give an abundant divisor. -/
theorem not_common_sixty_five {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → 65 ∣ N.factorization p + 1) : False := by
  have hexp5 : ∀ p ∈ N.primeFactors, p ≠ q → 5 ∣ N.factorization p + 1 := fun p hp hpq =>
    (by norm_num : 5 ∣ 65).trans (hexp p hp hpq)
  have hexp13 : ∀ p ∈ N.primeFactors, p ≠ q → 13 ∣ N.factorization p + 1 := fun p hp hpq =>
    (by norm_num : 13 ∣ 65).trans (hexp p hp hpq)
  have h5N := (five_dvd_and_ne_special_of_common h hq hodd hexp5).1
  have h13N := dvd_of_dvd_succ h hq hodd (by norm_num) (by norm_num) hexp13
  have hq12 := special_mod_twelve_of_common_five h hq hodd hexp5
  have hcq' : (fun b : ℕ => b % 12 == 1) q = true := by simp [hq12]
  by_cases hq13 : q = 13
  · subst hq13
    have h7N : 7 ∣ N := (prime_dvd_of_dvd_succ_special h hq hodd (by norm_num) (by norm_num)
      (by norm_num : 7 ∣ 13 + 1)).1
    have hseed : ∀ t ∈ nodes65.take 3, t ∣ N := by
      intro t ht
      have : nodes65.take 3 = [5, 13, 7] := by decide +kernel
      rw [this] at ht
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
      rcases ht with rfl | rfl | rfl
      · exact h5N
      · exact h13N
      · exact h7N
    exact false_of_reach h hexp (by norm_num) (by simp [cand65A]) hcq' nodes65_prime nodes65_ne2
      hseed (by decide +kernel) hrows65 hcand65A reach65A_none vals65_sel vals65_nodup PG65 ab65
  · have hseed : ∀ t ∈ nodes65.take 2, t ∣ N := by
      intro t ht
      have : nodes65.take 2 = [5, 13] := by decide +kernel
      rw [this] at ht
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
      rcases ht with rfl | rfl
      · exact h5N
      · exact h13N
    exact false_of_reach h hexp (by norm_num) (by simp [cand65B, hq12, hq13]) hcq'
      nodes65_prime nodes65_ne2 hseed (by decide +kernel) hrows65 hcand65B reach65B_none
      vals65_sel vals65_nodup PG65 ab65

/-- The ordinary exponents of an odd perfect number cannot all equal one `E` with
`65 ∣ E + 1`. -/
theorem not_all_exponents_eq_of_sixty_five_dvd_succ {N q E : ℕ} (h : OddPerfect N)
    (hq : q.Prime) (hodd : Odd (N.factorization q)) (hE : 65 ∣ E + 1)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = E) : False :=
  not_common_sixty_five h hq hodd fun p hp hpq => hexp p hp hpq ▸ hE

end OddPerfect

