/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `70`. -/
theorem not_all_exponents_eq_seventy {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 70) : False :=
  EqCount.checkCert_sound_of_mod_four EqCount.check71 (by norm_num) h hq hodd hexp

end OddPerfect

