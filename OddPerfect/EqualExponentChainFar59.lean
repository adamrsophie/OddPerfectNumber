/-- The tree for `l = 59` when `59` is the special prime. -/
def spec59 : Node :=
  .mod4

/-- The certificate for `l = 59` is accepted. -/
theorem check59 : checkAll 59 pc59 ord59 spec59 = true := by
  decide +kernel

end OddPerfect.EqChain

namespace OddPerfect

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `58`. Restricted family result; no published source was
checked; novelty not verified. -/
theorem not_all_exponents_eq_fifty_eight {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 58) : False :=
  EqChain.checkAll_sound EqChain.check59 h hq hodd hexp

end OddPerfect

#print axioms OddPerfect.EqChain.check59
#print axioms OddPerfect.not_all_exponents_eq_fifty_eight
