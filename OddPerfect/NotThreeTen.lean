import OddPerfect.NotThreeTenB
import OddPerfect.NotThreeNine

/-!
# Odd perfect numbers not divisible by 3 have at least ten distinct prime factors

`ten_le_card_primeFactors_of_not_three_dvd`: if `3 ∤ N` for an odd perfect number `N`, then `N`
has at least 10 distinct prime factors. This is known mathematics: Hagis (1983) and Kishore
(1983) proved eleven, and Nielsen (2007) proved twelve, for odd perfect numbers not divisible by
`3`. Only 10 is proved here.

Proof. By `nine_le_card_primeFactors_of_not_three_dvd` it suffices to exclude exactly 9 prime
factors. Such an `N` satisfies the search state with no listed primes and 9 further primes, all
above `4`. Its window (`OmegaSevenSearch.closed_of_window`) is `5, 7, 11, 13`; the children are closed in
`OddPerfect/NotThreeTenA.lean` and the following run files by kernel checks of the verified
engine `OmegaSevenEngine.run`, cut into checks of at most 3000 search nodes in the Python mirror
`scripts/OmegaSeven/engine.py`. No structural fact beyond the engine's own cuts is used. Mirror
nodes: 86706 in 109 checks, the largest 2991. Generated by `scripts/NotThreeTen/gen.py`.
-/

namespace OddPerfect.NotThreeTen

open OmegaSixSearch (Ent Holds kmin)
open OmegaSevenSearch (Closed closed_of_window window)

set_option maxRecDepth 100000

/-- Exactly 9 prime factors, none of them `3`, is impossible. -/
theorem closed_root : Closed [] 9 4 := by
  apply closed_of_window (by decide) (by decide +kernel)
  rw [show window [] 9 4 = [5, 7, 11, 13] by decide +kernel]
  simp only [List.forall_mem_cons, List.not_mem_nil, IsEmpty.forall_iff, implies_true, and_true]
  exact ⟨closed_5, closed_7, closed_11, closed_13⟩

end OddPerfect.NotThreeTen

namespace OddPerfect

open OmegaSixSearch (Holds)

/-- If `3 ∤ N` for an odd perfect number `N`, then `N` has at least 10 distinct prime factors.
Known: Hagis (1983) and Kishore (1983) proved eleven, Nielsen (2007) twelve. -/
theorem ten_le_card_primeFactors_of_not_three_dvd {N : ℕ} (h : OddPerfect N) (h3 : ¬ 3 ∣ N) :
    10 ≤ N.primeFactors.card := by
  have hK := nine_le_card_primeFactors_of_not_three_dvd h h3
  by_contra hlt
  have hk : N.primeFactors.card = 9 := by omega
  have H : Holds N [] 9 4 := by
    refine ⟨h, by simp, by simp, by simp [hk], ?_⟩
    intro q hq _
    have hqp := Nat.prime_of_mem_primeFactors hq
    have hd := Nat.dvd_of_mem_primeFactors hq
    have : q ≠ 2 := fun e => h.not_two_dvd (e ▸ hd)
    have : q ≠ 3 := fun e => h3 (e ▸ hd)
    have : q ≠ 4 := fun e => by subst e; norm_num at hqp
    have := hqp.two_le
    omega
  exact NotThreeTen.closed_root N H

end OddPerfect

