/-- The tree for `l = 47` when `47` is the special prime. -/
def spec47 : Node :=
  .mod4

/-- The certificate for `l = 47` is accepted. -/
theorem check47 : checkAll 47 pc47 ord47 spec47 = true := by
  decide +kernel

end OddPerfect.EqChain

namespace OddPerfect

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `46`. Restricted family result; no published source was
checked; novelty not verified. -/
theorem not_all_exponents_eq_forty_six {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 46) : False :=
  EqChain.checkAll_sound EqChain.check47 h hq hodd hexp

end OddPerfect

#print axioms OddPerfect.EqChain.check47
#print axioms OddPerfect.not_all_exponents_eq_forty_six
