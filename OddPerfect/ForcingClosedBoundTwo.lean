/-- The deletion from the odd primes up to `2000` empties in 10 rounds. -/
private lemma iterate_eq : (step 2000)^[10] (initial 2000) = [] := by
  rw [Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply', Function.iterate_succ_apply',
    Function.iterate_zero_apply, initial_eq, round1, round2, round3, round4, round5, round6, round7, round8, round9, round10]

end ForcingClosedBoundTwo

/-- **No forcing closed configuration below 2000.** Every forcing closed configuration has a
node above `2000`. Kernel checked, one round per lemma: the deletion rounds from `initial 2000`
reach `[]` after ten rounds. -/
theorem ForcingClosed.exists_gt_two_thousand {S : Finset ℕ} {e : ℕ → ℕ}
    (hF : ForcingClosed S e) : ∃ s ∈ S, 2000 < s :=
  ForcingClosedBoundTwo.exists_gt_of_iterate ForcingClosedBoundTwo.iterate_eq hF

end OddPerfect

