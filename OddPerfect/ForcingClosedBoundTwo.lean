import OddPerfect.ForcingClosedBound

/-!
# Forcing closed configurations have a node above 2000

The deletion of `OddPerfect/ForcingClosedBound.lean`, with a cheaper test for ordinary moves.
Start from `initial P0` (every odd prime up to `P0`, and a few composites that pass the cheap
sieve) and repeatedly delete every prime `p` of the current list
`A` that has no move inside `A`:

* a special move: `p % 4 = 1` and every prime factor of `p + 1` divides `2 * A.prod`;
* an ordinary move: an odd prime `l` with `2 * l + 1 ≤ P0`, some `r ∈ A` with `r % l = 1` and
  `p ^ l % r = 1`, and every prime factor of `(p ^ l - 1) / (p - 1)` divides `2 * A.prod`.

The extra condition on `r` is cheap (small numbers only) and holds for the row that the
soundness proof needs: the primitive prime divisor `r` of that row is a node with
`r % l = 1` and `p` of order `l` modulo `r`. It skips most of the expensive row tests.
The candidate `r` for each `l` are passed as a literal table, checked once per round.

* `ForcingClosedBoundTwo.exists_gt_of_iterate`: the criterion, for any `P0` and number of rounds.
* `ForcingClosed.exists_gt_two_thousand`: every forcing closed configuration has a node above
  `2000`.
-/

set_option Elab.async false

open ArithmeticFunction
open scoped ArithmeticFunction.sigma

namespace OddPerfect

namespace ForcingClosedBoundTwo

open ForcingClosedBound (smoothB smoothB_eq_true lengths initial smallSieveB_of_prime
  sigma_eq_div)

/-- For each length `l`, the members `r` of `A` with `r % l = 1`. -/
def table (Ls A : List ℕ) : List (ℕ × List ℕ) :=
  Ls.map fun l => (l, A.filter fun r => r % l == 1)

/-- Does `p` have a move, given `M = 2 * A.prod` and the table `T = table Ls A`? -/
def keepB (M : ℕ) (T : List (ℕ × List ℕ)) (p : ℕ) : Bool :=
  (p % 4 == 1 && smoothB M (p + 1) (p + 1)) ||
    T.any fun x => x.2.any (fun r => Pratt.powMod p x.1 r == 1) &&
      smoothB M ((p ^ x.1 - 1) / (p - 1)) (p * x.1)

/-- One round: delete every prime of `A` without a move inside `A`. -/
def step (P0 : ℕ) (A : List ℕ) : List ℕ :=
  A.filter (keepB (2 * A.prod) (table (lengths P0) A))

/-- A round evaluated with its product, its lengths and its table given as literals. -/
theorem step_eq {P0 M : ℕ} {A B Ls : List ℕ} {T : List (ℕ × List ℕ)}
    (hL : lengths P0 = Ls) (hM : 2 * A.prod = M) (hT : table Ls A = T)
    (h : A.filter (keepB M T) = B) : step P0 A = B := by
  rw [step, hM, hL, hT, h]

variable {S : Finset ℕ} {e : ℕ → ℕ}

/-- **The criterion.** If the iteration from `initial P0` reaches `[]`, then every
forcing closed configuration has a node above `P0`. -/
theorem exists_gt_of_iterate {P0 k : ℕ} (hk : (step P0)^[k] (initial P0) = [])
    (hF : ForcingClosed S e) : ∃ s ∈ S, P0 < s := by
  by_contra hcon
  simp only [not_exists, not_and, not_lt] at hcon
  obtain ⟨q, hq, hq4, -, -, hR, hRq, hRord⟩ := hF.reduce
  set e' := ForcingClosed.reduceExp q e
  have hdvdM : ∀ A : List ℕ, (∀ s ∈ S, s ∈ A) → ∀ s ∈ S,
      ∀ r ∈ (σ 1 (s ^ e' s)).primeFactors, r ∣ 2 * A.prod := by
    intro A hA s hs r hr
    by_cases hr2 : r = 2
    · rw [hr2]; exact dvd_mul_right 2 _
    · exact (List.dvd_prod (hA r (hR.2.2.1 s hs r hr hr2))).mul_left 2
  have hrow0 : ∀ s ∈ S, σ 1 (s ^ e' s) ≠ 0 := fun s hs =>
    (sigma_pos 1 _ (pow_ne_zero _ (hR.1 s hs).1.ne_zero)).ne'
  have hkeep : ∀ A : List ℕ, (∀ s ∈ S, s ∈ A) → ∀ s ∈ S,
      keepB (2 * A.prod) (table (lengths P0) A) s = true := by
    intro A hA s hs
    have hsp := (hR.1 s hs).1
    have hrow := sigma_eq_div hsp (e' s)
    unfold keepB
    rw [Bool.or_eq_true]
    by_cases hsq : s = q
    · left
      have hqp := (hR.1 q hq).1
      have h1 : σ 1 (q ^ e' q) = q + 1 := by
        rw [hRq, sigma_one_apply_prime_pow hqp]
        simp [Finset.sum_range_succ]
        ring
      rw [hsq, Bool.and_eq_true, beq_iff_eq]
      refine ⟨hq4, ?_⟩
      have hlt : σ 1 (q ^ e' q) < 2 ^ (q + 1) := by
        rw [h1]; exact Nat.lt_two_pow_self
      have := smoothB_eq_true (hrow0 q hq) hlt (hdvdM A hA q hq)
      rwa [h1] at this
    · right
      obtain ⟨hl, hl2⟩ := hRord s hs hsq
      set l := e' s + 1 with hl_def
      have hl3 : 3 ≤ l := by have := hl.two_le; omega
      obtain ⟨r, hr, hord, hmod⟩ := hR.exists_mem_mod_eq_one hs (by omega)
      rw [← hl_def] at hord hmod
      obtain ⟨hrp, hr2, -⟩ := hR.1 r hr
      have hrle := hcon r hr
      have hlodd : l % 2 = 1 := by
        rcases hl.eq_two_or_odd with h | h
        · exact absurd h hl2
        · exact h
      have hrodd : r % 2 = 1 := by
        rcases hrp.eq_two_or_odd with h | h
        · exact absurd h hr2
        · exact h
      -- `r ≡ 1 (mod l)` with `r` and `l` odd forces `2 * l + 1 ≤ r`
      have hlr : 2 * l + 1 ≤ r := by
        have hd := Nat.div_add_mod r l
        rw [hmod] at hd
        rcases Nat.lt_or_ge (r / l) 2 with ht | ht
        · interval_cases ht' : r / l
          · have := hrp.two_le; omega
          · omega
        · nlinarith
      -- `s ^ l % r = 1` from the order
      have hpow : s ^ l % r = 1 := by
        have h1 : ((s ^ l : ℕ) : ZMod r) = ((1 : ℕ) : ZMod r) := by
          push_cast
          rw [← hord]
          exact pow_orderOf_eq_one _
        rw [ZMod.natCast_eq_natCast_iff'] at h1
        rw [h1]
        exact Nat.mod_eq_of_lt (by have := hrp.two_le; omega)
      rw [List.any_eq_true]
      refine ⟨(l, A.filter fun r => r % l == 1), ?_, ?_⟩
      · unfold table
        refine List.mem_map.mpr ⟨l, ?_, rfl⟩
        unfold lengths
        rw [List.mem_filter, List.mem_range'_1]
        exact ⟨⟨by omega, by omega⟩, smallSieveB_of_prime hl⟩
      · rw [Bool.and_eq_true]
        refine ⟨?_, ?_⟩
        · rw [List.any_eq_true]
          refine ⟨r, List.mem_filter.mpr ⟨hA r hr, by simpa using hmod⟩, ?_⟩
          rw [Pratt.powMod_eq, hpow]
          rfl
        · show smoothB (2 * A.prod) ((s ^ l - 1) / (s - 1)) (s * l) = true
          rw [← hrow]
          have hlt : σ 1 (s ^ e' s) < 2 ^ (s * l) := by
            rw [hrow, pow_mul]
            calc (s ^ l - 1) / (s - 1) ≤ s ^ l - 1 := Nat.div_le_self _ _
              _ < s ^ l := Nat.sub_lt (Nat.pow_pos hsp.pos) Nat.one_pos
              _ ≤ (2 ^ s) ^ l := Nat.pow_le_pow_left Nat.lt_two_pow_self.le _
          exact smoothB_eq_true (hrow0 s hs) hlt (hdvdM A hA s hs)
  have hall : ∀ n, ∀ s ∈ S, s ∈ (step P0)^[n] (initial P0) := by
    intro n
    induction n with
    | zero =>
      intro s hs
      obtain ⟨hsp, hs2, -⟩ := hR.1 s hs
      have := hsp.two_le
      have := hcon s hs
      simp only [Function.iterate_zero, id, initial, List.mem_filter, List.mem_range'_1]
      exact ⟨⟨by omega, by omega⟩, smallSieveB_of_prime hsp⟩
    | succ n ih =>
      intro s hs
      rw [Function.iterate_succ_apply', step, List.mem_filter]
      exact ⟨ih s hs, hkeep _ ih s hs⟩
  have := hall k q hq
  rw [hk] at this
  simp at this

