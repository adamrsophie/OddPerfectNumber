/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `60`. -/
theorem not_all_exponents_eq_sixty {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 60) : False :=
  EqCount.checkCert_sound EqCount.check61 h hq hodd hexp

end OddPerfect

