/-- The cases for `l = 97`. -/
def cases97 : List (ℕ × List (ℕ × ℕ × ℕ)) :=
  []

/-- The Pratt certificates for `l = 97` are accepted. -/
theorem pc97_ok : Pratt.check pc97 = true := by
  decide +kernel

/-- The main case for `l = 97` is accepted. -/
theorem main97_ok : checkCase 97 pc97 none (cases97.map Prod.fst) main97 = true := by
  decide +kernel

/-- The certificate for `l = 97` is accepted. -/
theorem check97 : checkCert 97 pc97 main97 cases97 = true := by
  refine checkCert_of (by decide +kernel) (by norm_num) pc97_ok main97_ok fun c hc => ?_
  simp [cases97] at hc

end OddPerfect.EqCount

namespace OddPerfect

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `96`. -/
theorem not_all_exponents_eq_ninety_six {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 96) : False :=
  EqCount.checkCert_sound EqCount.check97 h hq hodd hexp

end OddPerfect

