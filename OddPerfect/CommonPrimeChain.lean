/-- Equal exponents in a checked family. Let `N` be an odd perfect number with special prime
`q`, `r ≠ q` an odd prime with `r ^ k ∣ E + 1`, `k ≥ 1`, and `v_p(N) = E` for every ordinary
prime `p`. If the table with nodes `r :: tail` is accepted with count `K`, then `k K ≤ E`. -/
theorem mul_le_of_check_of_forall_eq {N q r k K passes E : ℕ} {tail : List ℕ}
    {rows : List (List ℕ)} (h : OddPerfect N) (hq : q.Prime) (hodd : Odd (N.factorization q))
    (hr : r.Prime) (hr2 : r ≠ 2) (hrq : r ≠ q) (hk : 1 ≤ k) (hrk : r ^ k ∣ E + 1)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = E)
    (hP : ∀ t ∈ tail, t.Prime) (hc : CommonChain.check r tail rows passes K = true) :
    k * K ≤ E := by
  have hexp' : ∀ p ∈ N.primeFactors, p ≠ q → r ^ k ∣ N.factorization p + 1 :=
    fun p hp hpq => hexp p hp hpq ▸ hrk
  have hle := mul_le_factorization_of_check h hq hodd hr hr2 hrq hk hexp' hP hc
  have hrN : r ∣ N := dvd_of_dvd_succ h hq hodd hr hr2 fun p hp hpq =>
    (dvd_pow_self r (by omega)).trans (hexp' p hp hpq)
  rwa [hexp r (Nat.mem_primeFactors.mpr ⟨hr, hrN, h.ne_zero⟩) hrq] at hle

/-- The abundancy of `3 ^ 4 · 5 ^ 5 · 11 ^ 2` exceeds `2`. -/
private theorem two_lt_abundancy_3_5_11 : 2 < abundancy (3 ^ 4 * 5 ^ 5 * 11 ^ 2) := by
  rw [abundancy_mul_of_coprime (by norm_num), abundancy_mul_of_coprime (by norm_num),
    abundancy_prime_pow (by norm_num), abundancy_prime_pow (by norm_num),
    abundancy_prime_pow (by norm_num)]
  norm_num [Finset.sum_range_succ]

/-- In the common `5` family, `5` is ordinary. Let `N` be an odd perfect number with special
prime `q` and `5 ∣ v_p(N) + 1` for every ordinary prime `p`. Then `5 ∣ N` and `5 ≠ q`. -/
theorem five_dvd_and_ne_special_of_common {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → 5 ∣ N.factorization p + 1) : 5 ∣ N ∧ 5 ≠ q := by
  have p3 : Nat.Prime 3 := by norm_num
  have p5 : Nat.Prime 5 := by norm_num
  have p11 : Nat.Prime 11 := by norm_num
  have hm : ∀ {p : ℕ}, p.Prime → p ∣ N → p ∈ N.primeFactors := fun hp hpN =>
    Nat.mem_primeFactors.mpr ⟨hp, hpN, h.ne_zero⟩
  refine ⟨dvd_of_dvd_succ h hq hodd p5 (by norm_num) hexp, ?_⟩
  rintro h5q
  subst h5q
  have e5 : 4 ≤ N.factorization 5 :=
    (p5.pow_dvd_iff_le_factorization h.ne_zero).mp (pow_four_dvd_of_dvd_succ h hq hodd hexp)
  have m5 := (mod_four_special h hq hodd).2
  obtain ⟨h3N, h35⟩ := prime_dvd_of_dvd_succ_special h hq hodd p3 (by norm_num)
    (by norm_num : 3 ∣ 5 + 1)
  have e3 := hexp 3 (hm p3 h3N) h35
  have h11N : 11 ∣ N := dvd_of_dvd_geom_sum_of_dvd_succ h p3 (by norm_num) e3 p11
    (by norm_num) (by norm_num [Finset.sum_range_succ])
  have e11 := hexp 11 (hm p11 h11N) (by norm_num)
  have l3 := Nat.le_of_dvd (by omega) e3
  have l11 := Nat.le_of_dvd (by omega) e11
  have d3 : 3 ^ 4 ∣ N := (p3.pow_dvd_iff_le_factorization h.ne_zero).mpr (by omega)
  have d5 : 5 ^ 5 ∣ N := (p5.pow_dvd_iff_le_factorization h.ne_zero).mpr (by omega)
  have d11 : 11 ^ 2 ∣ N := (p11.pow_dvd_iff_le_factorization h.ne_zero).mpr (by omega)
  have hd : 3 ^ 4 * 5 ^ 5 * 11 ^ 2 ∣ N :=
    Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num)
      (Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) d3 d5) d11
  exact not_perfect_of_dvd_of_two_lt_abundancy hd two_lt_abundancy_3_5_11 h.perfect

/-- In the common `5` family, `5 ^ 186 ∣ N`. -/
theorem pow_dvd_of_common_five {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → 5 ∣ N.factorization p + 1) : 5 ^ 186 ∣ N := by
  have hle := mul_le_factorization_of_check (k := 1) h hq hodd (by norm_num) (by norm_num)
    (five_dvd_and_ne_special_of_common h hq hodd hexp).2 le_rfl (by simpa using hexp)
    CommonChain.nodes5_prime CommonChain.check5
  exact ((show Nat.Prime 5 by norm_num).pow_dvd_iff_le_factorization h.ne_zero).mpr (by omega)

/-- In the common `7` family, `7 ^ 124 ∣ N`. -/
theorem pow_dvd_of_common_seven {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → 7 ∣ N.factorization p + 1) : 7 ^ 124 ∣ N := by
  have h7q : 7 ≠ q := fun h7 => by have := (mod_four_special h hq hodd).1; omega
  have hle := mul_le_factorization_of_check (k := 1) h hq hodd (by norm_num) (by norm_num)
    h7q le_rfl (by simpa using hexp) CommonChain.nodes7_prime CommonChain.check7
  exact ((show Nat.Prime 7 by norm_num).pow_dvd_iff_le_factorization h.ne_zero).mpr (by omega)

/-- If the ordinary exponents of an odd perfect number all equal `E` with `5 ∣ E + 1`, then
`E ≥ 186`. -/
theorem not_all_exponents_eq_of_five_dvd_succ {N q E : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q)) (h5 : 5 ∣ E + 1) (hE : E < 186)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = E) : False := by
  have h5q := (five_dvd_and_ne_special_of_common h hq hodd fun p hp hpq =>
    hexp p hp hpq ▸ h5).2
  have := mul_le_of_check_of_forall_eq (k := 1) h hq hodd (by norm_num) (by norm_num) h5q
    le_rfl (by simpa using h5) hexp CommonChain.nodes5_prime CommonChain.check5
  omega

