`E ≥ 124`. -/
theorem not_all_exponents_eq_of_seven_dvd_succ {N q E : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q)) (h7 : 7 ∣ E + 1) (hE : E < 124)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = E) : False := by
  have h7q : 7 ≠ q := fun h7 => by have := (mod_four_special h hq hodd).1; omega
  have := mul_le_of_check_of_forall_eq (k := 1) h hq hodd (by norm_num) (by norm_num) h7q
    le_rfl (by simpa using h7) hexp CommonChain.nodes7_prime CommonChain.check7
  omega

