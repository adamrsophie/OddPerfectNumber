theorem not_all_exponents_eq_thirty_four {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 34) : False :=
  not_all_exponents_eq_of_five_dvd_succ h hq hodd (by norm_num) (by norm_num) hexp

