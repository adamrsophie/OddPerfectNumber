import OddPerfect.KanoldFive
import OddPerfect.EqualExponentChain

/-!
# Forcing chains in the common `r` family

Let `N` be an odd perfect number with special prime `q`, and let `r` be an odd prime that
divides `v_p(N) + 1` for every ordinary prime `p` (the common `r` family). Then:

* for an ordinary prime `p`, every odd prime factor `t` of `Φ_r(p) = 1 + p + ... + p ^ (r - 1)`
  divides `σ(p ^ v_p(N))` and hence `N` (`dvd_of_dvd_geom_sum_of_dvd_succ`);
* the `r`-adic ledger: if `r ^ k ∣ v_p(N) + 1` for every ordinary `p`, then `k` times the number
  of ordinary prime factors `p ≡ 1 (mod r)` is at most `v_r(N)` (`mul_card_le_factorization`).

A forcing table lists nodes `r = t₀, t₁, ..., t_n` and for each source node `t_i` a row of
receiver indices `j` with `t_j ∣ Φ_r(t_i)`. Since `q` is unknown, the checker computes, for every
node `b ≡ 1 (mod 4)` and for one value outside the table, the set of nodes reached from `r` when
rows whose source equals `b` are never used, and checks that at least `K` nodes other than `r`
and `b` are reached. Reaching is computed with bit masks by a fixed number of in order passes
over the rows. Every reached node `≡ 1 (mod r)` other than `q` is then an ordinary prime factor,
so `k K ≤ v_r(N)` (`mul_le_factorization_of_check`).

Instances: `r = 5` with `K = 186` and `r = 7` with `K = 124`. These are results of a known type.
-/

open ArithmeticFunction
open scoped ArithmeticFunction.sigma

namespace OddPerfect

/-- Let `N` be an odd perfect number and `p` a prime with `r ∣ v_p(N) + 1`, `r ≥ 1`. Every odd
prime `t` dividing `1 + p + ... + p ^ (r - 1)` divides `N`. -/
theorem dvd_of_dvd_geom_sum_of_dvd_succ {N p r t : ℕ} (h : OddPerfect N) (hp : p.Prime)
    (hr : 1 ≤ r) (hpr : r ∣ N.factorization p + 1) (ht : t.Prime) (ht2 : t ≠ 2)
    (hdvd : t ∣ ∑ i ∈ Finset.range r, p ^ i) : t ∣ N := by
  refine OPNStarter.force_prime h.perfect hp rfl ht ht2 (hdvd.trans ?_)
  have := OPNExample.sigma_prime_pow_dvd hp (a := r - 1) (e := N.factorization p)
    (by rwa [Nat.sub_add_cancel hr])
  rwa [sigma_one_apply_prime_pow hp, Nat.sub_add_cancel hr] at this

/-- The `r`-adic ledger. Let `N` be an odd perfect number with special prime `q`, `r` an odd
prime with `r ^ k ∣ v_p(N) + 1` for every ordinary `p`. If every element of `T` is an ordinary
prime factor `≡ 1 (mod r)`, then `k · |T| ≤ v_r(N)`. -/
theorem mul_card_le_factorization {N q r k : ℕ} (h : OddPerfect N) (hr : r.Prime) (hr2 : r ≠ 2)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → r ^ k ∣ N.factorization p + 1)
    {T : Finset ℕ} (hT : ∀ p ∈ T, p ∈ N.primeFactors ∧ p ≠ q ∧ p % r = 1) :
    k * T.card ≤ N.factorization r := by
  have : Fact r.Prime := ⟨hr⟩
  have hsub : T ⊆ N.primeFactors.filter (fun p => p % r = 1) := fun p hp =>
    Finset.mem_filter.mpr ⟨(hT p hp).1, (hT p hp).2.2⟩
  have hlo : ∀ p ∈ T, k ≤ padicValNat r (N.factorization p + 1) := fun p hp => by
    rw [Nat.padicValNat_def]
    exact (padicValNat_dvd_iff_le (by omega)).mp (hexp p (hT p hp).1 (hT p hp).2.1)
  have hsum := Finset.card_nsmul_le_sum T _ k hlo
  have hs := Finset.sum_le_sum_of_subset (f := fun p => padicValNat r (N.factorization p + 1))
    hsub
  have hled := sum_padicValNat_succ_le h.perfect hr hr2
  rw [smul_eq_mul, Nat.mul_comm] at hsum
  exact hsum.trans (hs.trans hled)

namespace CommonChain

open OddPerfect.EqChain (gm gm_eq nodupB)

/-! ## The checker -/

/-- The bit mask `∑ 2 ^ j` (as a bitwise or) of a list of indices. -/
def maskOf : List ℕ → ℕ
  | [] => 0
  | j :: js => 2 ^ j ||| maskOf js

/-- One in order pass over the rows: row `i` is used when bit `i` of `M` is set and the source
node `x` differs from the blocked value `b`; it then sets the bits of its receivers. -/
def pass (b : ℕ) : ℕ → List ℕ → List (List ℕ) → ℕ → ℕ
  | _, [], _, M => M
  | _, _ :: _, [], M => M
  | i, x :: xs, row :: rs, M =>
    pass b (i + 1) xs rs (if M.testBit i && x != b then M ||| maskOf row else M)

/-- `n` passes over the table. -/
def iter (b : ℕ) (nodes : List ℕ) (rows : List (List ℕ)) : ℕ → ℕ → ℕ
  | 0, M => M
  | n + 1, M => iter b nodes rows n (pass b 0 nodes rows M)

/-- The reached nodes (bit set in `M`) different from `b`, starting at index `i`. -/
def sel (b M : ℕ) : ℕ → List ℕ → List ℕ
  | _, [] => []
  | i, x :: xs => if M.testBit i && x != b then x :: sel b M (i + 1) xs else sel b M (i + 1) xs

/-- The number of nodes other than `r` and `b` reached from `r` with the source `b` blocked. -/
def reachCount (r : ℕ) (tail : List ℕ) (rows : List (List ℕ)) (passes b : ℕ) : ℕ :=
  (sel b (iter b (r :: tail) rows passes 1) 1 tail).length

/-- Every receiver `t_j` of the row of `t_i` divides `Φ_r(t_i)`. -/
def rowsOK (r : ℕ) (nodes : List ℕ) (rows : List (List ℕ)) : Bool :=
  (nodes.zip rows).all fun e => e.2.all fun j => gm e.1 (nodes.getD j 0) r == 0

/-- The checker for a table with nodes `r :: tail`: distinct nodes, all of `tail` are
`≡ 1 (mod r)`, the divisibilities of all rows, and the robust count `K` for every blocked node
`≡ 1 (mod 4)` and for the blocked value `0` (standing for a value outside the table). -/
def check (r : ℕ) (tail : List ℕ) (rows : List (List ℕ)) (passes K : ℕ) : Bool :=
  nodupB (r :: tail) && tail.all (fun t => t % r == 1) && rowsOK r (r :: tail) rows &&
    tail.all (fun t => t % 4 != 1 || decide (K ≤ reachCount r tail rows passes t)) &&
    decide (K ≤ reachCount r tail rows passes 0)

/-! ## Soundness of the checker -/

/-- Soundness of `nodupB`. -/
theorem nodup_of_nodupB : ∀ {l : List ℕ}, nodupB l = true → l.Nodup
  | [], _ => List.nodup_nil
  | a :: l, h => by
    rw [nodupB, Bool.and_eq_true] at h
    refine List.nodup_cons.mpr ⟨fun hm => ?_, nodup_of_nodupB h.2⟩
    simp only [Bool.not_eq_true'] at h
    exact absurd (List.contains_iff_mem.mpr hm) (by rw [h.1]; decide)

/-- The bits of `maskOf js` are the elements of `js`. -/
theorem testBit_maskOf (k : ℕ) : ∀ js : List ℕ, (maskOf js).testBit k = true ↔ k ∈ js
  | [] => by simp [maskOf]
  | j :: js => by
    rw [maskOf, Nat.testBit_lor, Bool.or_eq_true, Nat.testBit_two_pow, testBit_maskOf k js]
    simp [eq_comm]

/-- Reading the head of a suffix. -/
private theorem drop_facts {nodes xs : List ℕ} {i x : ℕ} (hd : nodes.drop i = x :: xs) :
    nodes.getD i 0 = x ∧ x ∈ nodes ∧ nodes.drop (i + 1) = xs := by
  refine ⟨?_, List.mem_of_mem_drop (hd ▸ List.mem_cons_self), ?_⟩
  · have := congrArg (fun l : List ℕ => l[0]?) hd
    simp only [List.getElem?_drop, Nat.add_zero, List.getElem?_cons_zero] at this
    rw [List.getD_eq_getElem?_getD, this, Option.getD_some]
  · rw [← List.drop_drop, hd, List.drop_one, List.tail_cons]

/-- A pass preserves the property that every set bit indexes a divisor of `N`. -/
theorem pass_good {N r b : ℕ} {nodes : List ℕ}
    (hstep : ∀ x ∈ nodes, x ∣ N → x ≠ b → ∀ t ∈ nodes, gm x t r = 0 → t ∣ N)
    (hgm0 : ∀ x ∈ nodes, gm x 0 r ≠ 0) :
    ∀ (xs : List ℕ) (rs : List (List ℕ)) (i M : ℕ), nodes.drop i = xs →
      (∀ e ∈ xs.zip rs, ∀ j ∈ e.2, gm e.1 (nodes.getD j 0) r = 0) →
      (∀ k, M.testBit k = true → nodes.getD k 0 ∣ N) →
      ∀ k, (pass b i xs rs M).testBit k = true → nodes.getD k 0 ∣ N
  | [], _, _, _, _, _, hM => hM
  | _ :: _, [], _, _, _, _, hM => hM
  | x :: xs, row :: rs, i, M, hd, hz, hM => by
    obtain ⟨hxi, hxn, hd'⟩ := drop_facts hd
    refine pass_good hstep hgm0 xs rs (i + 1) _ hd'
      (fun e he => hz e (List.mem_cons_of_mem _ he)) ?_
    intro k hk
    by_cases hc : (M.testBit i && x != b) = true
    · rw [if_pos hc, Nat.testBit_lor, Bool.or_eq_true, testBit_maskOf] at hk
      rcases hk with hk | hk
      · exact hM k hk
      simp only [Bool.and_eq_true, bne_iff_ne] at hc
      have hg := hz (x, row) List.mem_cons_self k hk
      have hxN : x ∣ N := hxi ▸ hM i hc.1
      by_cases hkl : k < nodes.length
      · rw [List.getD_eq_getElem _ _ hkl] at hg ⊢
        exact hstep x hxn hxN hc.2 _ (List.getElem_mem hkl) hg
      · rw [List.getD_eq_default _ _ (by omega)] at hg
        exact absurd hg (hgm0 x hxn)
    · rw [if_neg hc] at hk
      exact hM k hk

/-- `iter` preserves the same property. -/
theorem iter_good {N r b : ℕ} {nodes : List ℕ} {rows : List (List ℕ)}
    (hstep : ∀ x ∈ nodes, x ∣ N → x ≠ b → ∀ t ∈ nodes, gm x t r = 0 → t ∣ N)
    (hgm0 : ∀ x ∈ nodes, gm x 0 r ≠ 0)
    (hz : ∀ e ∈ nodes.zip rows, ∀ j ∈ e.2, gm e.1 (nodes.getD j 0) r = 0) :
    ∀ (n M : ℕ), (∀ k, M.testBit k = true → nodes.getD k 0 ∣ N) →
      ∀ k, (iter b nodes rows n M).testBit k = true → nodes.getD k 0 ∣ N
  | 0, _, hM => hM
  | n + 1, M, hM => iter_good hstep hgm0 hz n _
      (pass_good hstep hgm0 nodes rows 0 M (List.drop_zero) hz hM)

/-- `sel` is a sublist of its input. -/
theorem sel_sublist (b M : ℕ) : ∀ (i : ℕ) (xs : List ℕ), (sel b M i xs).Sublist xs
  | _, [] => List.Sublist.slnil
  | i, x :: xs => by
    rw [sel]
    split_ifs
    · exact (sel_sublist b M (i + 1) xs).cons_cons x
    · exact (sel_sublist b M (i + 1) xs).cons x

/-- Elements selected by `sel`. -/
theorem mem_sel {b M : ℕ} {nodes : List ℕ} : ∀ (xs : List ℕ) (i : ℕ), nodes.drop i = xs →
    ∀ y ∈ sel b M i xs, y ≠ b ∧ ∃ k, M.testBit k = true ∧ nodes.getD k 0 = y
  | [], _, _, y, hy => by simp [sel] at hy
  | x :: xs, i, hd, y, hy => by
    obtain ⟨hxi, -, hd'⟩ := drop_facts hd
    rw [sel] at hy
    split_ifs at hy with hc
    · rcases List.mem_cons.mp hy with rfl | hy
      · simp only [Bool.and_eq_true, bne_iff_ne] at hc
        exact ⟨hc.2, i, hc.1, hxi⟩
      · exact mem_sel xs (i + 1) hd' y hy
    · exact mem_sel xs (i + 1) hd' y hy

end CommonChain

open CommonChain EqChain in
/-- Soundness of the forcing table checker. Let `N` be an odd perfect number with special prime
`q`, `r ≠ q` an odd prime, `k ≥ 1`, and `r ^ k ∣ v_p(N) + 1` for every ordinary prime `p`. If the
table with nodes `r :: tail` (all of `tail` prime) is accepted with count `K`, then
`k K ≤ v_r(N)`. -/
theorem mul_le_factorization_of_check {N q r k K passes : ℕ} {tail : List ℕ}
    {rows : List (List ℕ)} (h : OddPerfect N) (hq : q.Prime) (hodd : Odd (N.factorization q))
    (hr : r.Prime) (hr2 : r ≠ 2) (hrq : r ≠ q) (hk : 1 ≤ k)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → r ^ k ∣ N.factorization p + 1)
    (hP : ∀ t ∈ tail, t.Prime) (hc : check r tail rows passes K = true) :
    k * K ≤ N.factorization r := by
  rw [check] at hc
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨⟨⟨hnd, hmod⟩, hrows⟩, hcand⟩, h0⟩ := hc
  have hmod' : ∀ t ∈ tail, t % r = 1 := fun t ht => by
    simpa using (List.all_eq_true.mp hmod) t ht
  have hnd' := nodup_of_nodupB hnd
  have hexp1 : ∀ p ∈ N.primeFactors, p ≠ q → r ∣ N.factorization p + 1 := fun p hp hpq =>
    (dvd_pow_self r (by omega)).trans (hexp p hp hpq)
  have hrN : r ∣ N := dvd_of_dvd_succ h hq hodd hr hr2 hexp1
  have hr3 : 3 ≤ r := by have := hr.two_le; omega
  have hnodes : ∀ y ∈ r :: tail, y.Prime ∧ y ≠ 2 := by
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact ⟨hr, hr2⟩
    · refine ⟨hP y hy, fun h2 => ?_⟩
      have := hmod' y hy
      rw [h2, Nat.mod_eq_of_lt (by omega)] at this
      omega
  have hmem : ∀ {p : ℕ}, p.Prime → p ∣ N → p ∈ N.primeFactors := fun hp hpN =>
    Nat.mem_primeFactors.mpr ⟨hp, hpN, h.ne_zero⟩
  have key : ∀ b, (∀ y ∈ r :: tail, y ≠ b → y ≠ q) →
      k * reachCount r tail rows passes b ≤ N.factorization r := by
    intro b hb
    have hstep : ∀ x ∈ r :: tail, x ∣ N → x ≠ b → ∀ t ∈ r :: tail, gm x t r = 0 → t ∣ N := by
      intro x hx hxN hxb t ht hg
      have hxp := (hnodes x hx).1
      exact dvd_of_dvd_geom_sum_of_dvd_succ h hxp (by omega)
        (hexp1 x (hmem hxp hxN) (hb x hx hxb)) (hnodes t ht).1 (hnodes t ht).2
        (Nat.dvd_of_mod_eq_zero (by rw [← gm_eq]; exact hg))
    have hgm0 : ∀ x ∈ r :: tail, gm x 0 r ≠ 0 := by
      intro x hx
      rw [gm_eq, Nat.mod_zero]
      exact (Finset.sum_pos (fun i _ => pow_pos (hnodes x hx).1.pos i)
        (Finset.nonempty_range_iff.mpr (by omega))).ne'
    have hz : ∀ e ∈ (r :: tail).zip rows, ∀ j ∈ e.2,
        gm e.1 ((r :: tail).getD j 0) r = 0 := by
      intro e he j hj
      have := List.all_eq_true.mp (List.all_eq_true.mp hrows e he) j hj
      simpa using this
    have h1 : ∀ k, (1 : ℕ).testBit k = true → (r :: tail).getD k 0 ∣ N := by
      intro k hk
      rw [show (1 : ℕ) = 2 ^ 0 by rfl, Nat.testBit_two_pow] at hk
      simp only [decide_eq_true_eq] at hk
      subst hk
      simpa using hrN
    have hgood := iter_good hstep hgm0 hz passes 1 h1
    set M := iter b (r :: tail) rows passes 1 with hM
    set L := sel b M 1 tail with hL
    have hLnd : L.Nodup := (sel_sublist b M 1 tail).nodup (List.nodup_cons.mp hnd').2
    have hT : ∀ p ∈ L.toFinset, p ∈ N.primeFactors ∧ p ≠ q ∧ p % r = 1 := by
      intro p hp
      rw [List.mem_toFinset] at hp
      have hpt : p ∈ tail := (sel_sublist b M 1 tail).subset hp
      obtain ⟨hpb, j, hj, hjp⟩ := mem_sel (nodes := r :: tail) tail 1 rfl p hp
      have hpN : p ∣ N := hjp ▸ hgood j hj
      exact ⟨hmem (hP p hpt) hpN, hb p (List.mem_cons_of_mem _ hpt) hpb, hmod' p hpt⟩
    have := mul_card_le_factorization h hr hr2 hexp hT
    rwa [List.toFinset_card_of_nodup hLnd] at this
  by_cases hqt : q ∈ tail
  · have hq4 := (mod_four_special h hq hodd).1
    have := (List.all_eq_true.mp hcand) q hqt
    simp only [hq4, bne_self_eq_false, Bool.false_or, decide_eq_true_eq] at this
    exact (Nat.mul_le_mul_left k this).trans (key q fun y _ hy => hy)
  · refine (Nat.mul_le_mul_left k h0).trans (key 0 fun y hy _ => ?_)
    rcases List.mem_cons.mp hy with rfl | hy
    · exact hrq
    · rintro rfl; exact hqt hy

