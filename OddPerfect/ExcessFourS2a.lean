theorem treeS2a_toList : treeS2a.toList = prattS2a.map Prod.fst := by decide +kernel

/-- The primality oracle: the verified table below 4096, the search tree from 4096 on. -/
def prS2a (n : ℕ) : Bool := cond (Nat.blt n 4096) (primeB n) (treeS2a.mem n)

/-- Soundness of the oracle. -/
theorem prS2a_sound : ∀ n, prS2a n = true → n.Prime := by
  intro n h
  unfold prS2a at h
  cases hb : Nat.blt n 4096
  · simp only [hb, cond_false] at h
    have hm := PTree.mem_toList h
    rw [treeS2a_toList] at hm
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
    exact Pratt.check_sound prattS2a_ok e he
  · simp only [hb, cond_true] at h
    exact primeB_sound h

