/-- Exclusion S2a: no odd perfect number with special prime `q` has exponent 4 at 3, at most two
further primes `r₁`, `r₂` of exponent 4, every other prime factor except `q` of exponent 2. This
concerns only this restricted family, not odd perfect numbers in general. -/
theorem excessS2a : ExcessS2a := by
  intro N q r₁ r₂ h hq hodd h3 hr₁ hr₂ hsq
  exact checkV_sound (defSound paramsS2a) prS2a_sound (fun _ _ _ _ hd _ => Bool.false_ne_true hd)
    (fun hl => absurd hl (by decide)) certS2a_ok
    (famV_S2a (P := paramsS2a) rfl (by decide) h hq hodd h3 hr₁ hr₂ hsq)

end OddPerfect

