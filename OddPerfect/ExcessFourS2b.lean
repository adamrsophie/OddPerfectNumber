  (262209281, 3, [2, 2, 2, 2, 2, 2, 2, 2, 5, 127, 1613])]

theorem prattS2b_ok : Pratt.check prattS2b = true := by decide +kernel

/-- A search tree over the primes of `prattS2b`. -/
def treeS2b : PTree := (.node (.node (.node (.node .leaf 127 .leaf) 131 .leaf) 137 (.node (.node .leaf 307 .leaf) 1613 .leaf)) 4933 (.node (.node (.node .leaf 17293 .leaf) 21491 .leaf) 30941 (.node .leaf 262209281 .leaf)))

theorem treeS2b_toList : treeS2b.toList = prattS2b.map Prod.fst := by decide +kernel

/-- The primality oracle: the verified table below 4096, the search tree from 4096 on. -/
def prS2b (n : ℕ) : Bool := cond (Nat.blt n 4096) (primeB n) (treeS2b.mem n)

/-- Soundness of the oracle. -/
theorem prS2b_sound : ∀ n, prS2b n = true → n.Prime := by
  intro n h
  unfold prS2b at h
  cases hb : Nat.blt n 4096
  · simp only [hb, cond_false] at h
    have hm := PTree.mem_toList h
    rw [treeS2b_toList] at hm
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
    exact Pratt.check_sound prattS2b_ok e he
  · simp only [hb, cond_true] at h
    exact primeB_sound h

