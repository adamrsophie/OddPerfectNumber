open ExcessFourS2b

/-- Exclusion S2b: no odd perfect number with special prime `q` has exponent 2 at 3, at most
three primes `r₁`, `r₂`, `r₃` of exponent 4, every other prime factor except `q` of exponent 2.
This concerns only this restricted family, not odd perfect numbers in general. -/
theorem excessS2b : ExcessS2b := by
  intro N q r₁ r₂ r₃ h hq hodd h3 hr₁ hr₂ hr₃ hsq
  exact checkV_sound (defSound paramsS2b) prS2b_sound (fun _ _ _ _ hd _ => Bool.false_ne_true hd)
    (fun hl => absurd hl (by decide)) certS2b_ok
    (famV_S2b (P := paramsS2b) rfl (by decide) h hq hodd h3 hr₁ hr₂ hr₃ hsq)

