import OddPerfect.LowerBoundTwoTable

/-!
# Checks of the prime table, part 2

Part of a kernel checked lower bound `10 ^ 150` for odd perfect numbers by the factor
chain method, with the checker `run` of `OddPerfect.LowerBound`. The method and bounds of
this size are known: Brent, Cohen and te Riele (1991) reached `10 ^ 300` and Ochem and Rao
(2012) reached `10 ^ 1500`. The data are generated by `scripts/LowerBound/gentwo.py`.
-/

namespace OddPerfect.LowerBoundTwo

open OddPerfect.LowerBound

-- Check the theorems of this file one after another: in parallel the kernel checks of the
-- large `decide` proofs raise the peak memory above the budget of the library.
set_option Elab.async false

/-- The entries of `ptab212` pass the Lucas test against the whole table. -/
theorem ok_ptab212 : PT.allOK ptable ptab212 = true := by
  decide +kernel

