namespace OddPerfect

open OmegaSixSearch (Ent Holds kmin_le)

private theorem holds_root35 {N : ℕ} (h : OddPerfect N) (h3 : 3 ∈ N.primeFactors)
    (h5 : 5 ∈ N.primeFactors) {m : ℕ} (hm : ∀ q ∈ N.primeFactors, q ≠ 3 → q ≠ 5 → m < q) :
    Holds N [⟨3, 2, false⟩, ⟨5, 1, false⟩] (N.primeFactors.card - 2) m := by
  have h2 : 2 ≤ N.primeFactors.card := by
    have : ({3, 5} : Finset ℕ) ⊆ N.primeFactors := by
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl <;> assumption
    simpa using Finset.card_le_card this
  refine ⟨h, by simp, ?_, by simp; omega, ?_⟩
  · intro e he
    simp only [List.mem_cons, List.not_mem_nil, or_false] at he
    rcases he with rfl | rfl
    · exact ⟨h3, kmin_le h h3, fun h => by simp at h⟩
    · exact ⟨h5, kmin_le h h5, fun h => by simp at h⟩
  · intro q hq hn
    simp only [List.map_cons, List.map_nil, List.mem_cons,
      List.not_mem_nil, or_false, not_or] at hn
    exact hm q hq hn.1 hn.2

/-- An odd perfect number has at least seven distinct prime factors (Pomerance 1974). -/
theorem seven_le_card_primeFactors {N : ℕ} (h : OddPerfect N) : 7 ≤ N.primeFactors.card := by
  by_contra hlt
  have h6 : N.primeFactors.card = 6 := by have := six_le_card_primeFactors h; omega
  obtain ⟨h3, h5, -⟩ := exists_prime_dvd_of_card_eq_six h h6
  have m3 : 3 ∈ N.primeFactors := Nat.mem_primeFactors.mpr ⟨Nat.prime_three, h3, h.ne_zero⟩
  have m5 : 5 ∈ N.primeFactors := Nat.mem_primeFactors.mpr ⟨by norm_num, h5, h.ne_zero⟩
  have h7 : ¬ 7 ∣ N := fun h7 => not_105_dvd h (Nat.Coprime.mul_dvd_of_dvd_of_dvd
    (by norm_num) (Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h3 h5 : 15 ∣ N) h7)
  have H := holds_root35 h m3 m5 (m := 7) (by
    intro q hq hq3 hq5
    have hqp := Nat.prime_of_mem_primeFactors hq
    have hqN := Nat.dvd_of_mem_primeFactors hq
    have hq2 : q ≠ 2 := fun e => h.not_two_dvd (e ▸ hqN)
    have := hqp.two_le
    by_contra hle
    interval_cases q <;> simp_all <;> norm_num at hqp)
  rw [h6] at H
  exact OmegaSevenFinal.closed_3_5 N H

end OddPerfect

