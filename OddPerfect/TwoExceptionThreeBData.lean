theorem tgood9 {x : ℕ} (h3 : x % 3 = 1) (hlo : 27019 ≤ x) (hhi : x < 30001) :
    TGood 19881 x :=
  tcover_sound (fun p hp => by
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hp
    exact Pratt.check_sound tcert9_ok e he) twalk9 27019 twalk9_ok x hlo hhi (by omega)

/-- Every prime `11 ≤ x < 19881` with `x % 10 = 1` and `x ≠ 61` is closed. -/
theorem s_closed {x : ℕ} (hx : x.Prime) (h10 : x % 10 = 1) (h61 : x ≠ 61)
    (h11 : 11 ≤ x) (hlt : x < 19881) (N : ℕ) (hc : Ctx N x) : False := by
  by_cases c0 : x < 2011
  · exact sgood0 hx h10 h61 (by omega) c0 N hc
  by_cases c1 : x < 4011
  · exact sgood1 hx h10 h61 (by omega) c1 N hc
  by_cases c2 : x < 6011
  · exact sgood2 hx h10 h61 (by omega) c2 N hc
  by_cases c3 : x < 8011
  · exact sgood3 hx h10 h61 (by omega) c3 N hc
  by_cases c4 : x < 10011
  · exact sgood4 hx h10 h61 (by omega) c4 N hc
  by_cases c5 : x < 12011
  · exact sgood5 hx h10 h61 (by omega) c5 N hc
  by_cases c6 : x < 14011
  · exact sgood6 hx h10 h61 (by omega) c6 N hc
  by_cases c7 : x < 16011
  · exact sgood7 hx h10 h61 (by omega) c7 N hc
  by_cases c8 : x < 18011
  · exact sgood8 hx h10 h61 (by omega) c8 N hc
  exact sgood9 hx h10 h61 (by omega) hlt N hc

/-- Every `19 ≤ x < 30001` with `x % 3 = 1` is excluded as the square of branch B. -/
theorem t_closed {x : ℕ} (h3 : x % 3 = 1) (h19 : 19 ≤ x) (hlt : x < 30001) :
    TGood 19881 x := by
  by_cases c0 : x < 3019
  · exact tgood0 h3 (by omega) c0
  by_cases c1 : x < 6019
  · exact tgood1 h3 (by omega) c1
  by_cases c2 : x < 9019
  · exact tgood2 h3 (by omega) c2
  by_cases c3 : x < 12019
  · exact tgood3 h3 (by omega) c3
  by_cases c4 : x < 15019
  · exact tgood4 h3 (by omega) c4
  by_cases c5 : x < 18019
  · exact tgood5 h3 (by omega) c5
  by_cases c6 : x < 21019
  · exact tgood6 h3 (by omega) c6
  by_cases c7 : x < 24019
  · exact tgood7 h3 (by omega) c7
  by_cases c8 : x < 27019
  · exact tgood8 h3 (by omega) c8
  exact tgood9 h3 (by omega) hlt

