/-- Every `m` with `lo ≤ m < lo + n` is in `L` or has a divisor `d ∈ D` with
`2 ≤ d < m`. -/
def dCover (L D : List ℕ) (lo n : ℕ) : Bool :=
  (List.range' lo n).all fun m =>
    L.contains m || D.any (fun d => decide (2 ≤ d) && decide (d < m) && m % d == 0)

