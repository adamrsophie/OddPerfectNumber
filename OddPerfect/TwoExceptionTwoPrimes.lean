theorem treeTwo_toList : treeTwo.toList = prattTwo.map Prod.fst := by decide +kernel

/-- The primality oracle: the verified table below 4096, the search tree from 4096 on. -/
def prTwo (n : ℕ) : Bool := cond (Nat.blt n 4096) (primeB n) (treeTwo.mem n)

/-- Soundness of the oracle. -/
theorem prTwo_sound : ∀ n, prTwo n = true → n.Prime := by
  intro n h
  unfold prTwo at h
  cases hb : Nat.blt n 4096
  · simp only [hb, cond_false] at h
    have hm := PTree.mem_toList h
    rw [treeTwo_toList] at hm
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
    exact Pratt.check_sound prattTwo_ok e he
  · simp only [hb, cond_true] at h
    exact primeB_sound h

