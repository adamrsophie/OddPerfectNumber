/-- The tree for `l = 43` when `43` is the special prime. -/
def spec43 : Node :=
  .mod4

/-- The certificate for `l = 43` is accepted. -/
theorem check43 : checkAll 43 pc43 ord43 spec43 = true := by
  decide +kernel

end OddPerfect.EqChain

namespace OddPerfect

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `30`. -/
theorem not_all_exponents_eq_thirty {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 30) : False :=
  EqChain.checkAll_sound EqChain.check31 h hq hodd hexp

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `36`. -/
theorem not_all_exponents_eq_thirty_six {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 36) : False :=
  EqChain.checkAll_sound EqChain.check37 h hq hodd hexp

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `40`. -/
theorem not_all_exponents_eq_forty {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 40) : False :=
  EqChain.checkAll_sound EqChain.check41 h hq hodd hexp

/-- In an odd perfect number the exponents of the primes other than the special
prime cannot all equal `42`. -/
theorem not_all_exponents_eq_forty_two {N q : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hodd : Odd (N.factorization q))
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = 42) : False :=
  EqChain.checkAll_sound EqChain.check43 h hq hodd hexp

end OddPerfect

