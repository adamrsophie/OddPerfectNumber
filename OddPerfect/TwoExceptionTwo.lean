/-- The root states of all subtrees. -/
def rootsTwo : List (List Key × ℕ) := rootsTwo1 ++ (rootsTwo2 ++ (rootsTwo3 ++ (rootsTwo4 ++ (rootsTwo5 ++ (rootsTwo6 ++ (rootsTwo7 ++ rootsTwo8))))))

theorem rootsTwo_refuted : ∀ r ∈ rootsTwo, RefutedTwo r.1 r.2 := by
  intro r hr
  unfold rootsTwo at hr
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo1_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo2_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo3_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo4_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo5_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo6_refuted r h
  rcases List.mem_append.mp hr with h | hr
  · exact rootsTwo7_refuted r h
  exact rootsTwo8_refuted r hr

/-- Recognizes exactly the root states of the subtrees. -/
def doneTwo (ks : List Key) (x : ℕ) : Bool := rootsTwo.any fun r => r.2 == x && r.1 == ks

theorem doneTwo_sound : ∀ ks x N q, doneTwo ks x = true → Holds paramsTwo N q ks x → False := by
  intro ks x N q h hH
  obtain ⟨r, hr, hb⟩ := List.any_eq_true.mp h
  simp only [Bool.and_eq_true, beq_iff_eq] at hb
  obtain ⟨h1, h2⟩ := hb
  subst h1 h2
  exact rootsTwo_refuted r hr N q hH

