/-- The stopping test at the bound `m` for the threshold `t / 10^15`, with `r` and `u` the scaled
sums of the decided prime factors: `t < r`, or
`(2m - 3) t + (2m - 4) u ≤ (2m - 3) r + (2m - 4) λ` with `λ = 693147180300000`, written without
subtraction. -/
def sixEarly (t m r u : ℕ) : Bool :=
  decide (t < r) ||
    decide (2 * m * t + 2 * m * u + 3 * r + 4 * 693147180300000 ≤
      2 * m * r + 2 * m * 693147180300000 + 3 * t + 4 * u)

/-- The branch check over the list of triples `(p, n, u)`, with the bound `B` at the end: an entry
of `req` must divide `N` and an entry of `exc` must not. -/
def sixCheck (t B : ℕ) (req exc : List ℕ) : List (ℕ × ℕ × ℕ) → ℕ → ℕ → Bool
  | [], r, u => sixEarly t B r u
  | a :: l, r, u => sixEarly t a.1 r u ||
      ((req.contains a.1 || sixCheck t B req exc l r u) &&
        (exc.contains a.1 ||
          sixCheck t B req exc l (r + 1000000000000000 / a.1) (u + a.2.2)))

/-- The next bound after the entry: the first prime of the list, or `B` at the end. -/
def sixNext (B : ℕ) : List (ℕ × ℕ × ℕ) → ℕ
  | [] => B
  | a :: _ => a.1

/-- `sixGapAt K n c`: each of `n, n + 1, ..., n + c - 1` is even or has a divisor `d` with
`3 ≤ d < min(n, K)`. -/
def sixGapAt (K : ℕ) : ℕ → ℕ → Bool
  | _, 0 => true
  | n, c + 1 => (n % 2 == 0 || (List.range K).any fun d => 3 ≤ d && d < n && n % d == 0) &&
      sixGapAt K (n + 1) c

/-- The gap check: each entry is below the next bound, and between them there is no odd prime. -/
def sixGap (K B : ℕ) : List (ℕ × ℕ × ℕ) → Bool
  | [] => true
  | a :: l => decide (a.1 < sixNext B l) && sixGapAt K (a.1 + 1) (sixNext B l - a.1 - 1) &&
      sixGap K B l

private theorem not_prime_of_sixGapAt {K : ℕ} :
    ∀ (c n : ℕ), sixGapAt K n c = true → 3 ≤ n → ∀ q, n ≤ q → q < n + c → ¬ q.Prime := by
  intro c
  induction c with
  | zero => intro n _ _ q h1 h2; omega
  | succ c ih =>
    intro n hc hn q h1 h2 hq
    simp only [sixGapAt, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, List.any_eq_true,
      List.mem_range, decide_eq_true_eq] at hc
    obtain ⟨h0, hc⟩ := hc
    rcases Nat.lt_or_ge n q with hlt | hle
    · exact ih (n + 1) hc (by omega) q (by omega) (by omega) hq
    · obtain rfl : q = n := by omega
      rcases h0 with h0 | ⟨d, -, ⟨h3d, hdq⟩, hd⟩
      · have := hq.eq_one_or_self_of_dvd 2 (Nat.dvd_of_mod_eq_zero h0)
        omega
      · have := hq.eq_one_or_self_of_dvd d (Nat.dvd_of_mod_eq_zero hd)
        omega

private theorem log_div_sub_one_le_recipFourLogUp_six {p : ℕ} (hp : 2 ≤ p) (n : ℕ) :
    Real.log ((p : ℝ) / (p - 1)) ≤ (recipFourLogUp p n : ℝ) := by
  have hp' : (2 : ℝ) ≤ p := by exact_mod_cast hp
  rw [log_div_sub_one_eq (by linarith)]
  have h := neg_log_one_sub_le (x := 1 / (p : ℝ)) (by positivity)
    (by rw [div_lt_one (by linarith)]; linarith) n
  unfold recipFourLogUp
  push_cast
  exact h

/-- For `3 ≤ m ≤ q`: `2(m - 2) log(q/(q-1)) ≤ (2m - 3)/q`. -/
private theorem two_mul_log_div_sub_one_le_six {m q : ℝ} (hm : 3 ≤ m) (hq : m ≤ q) :
    2 * (m - 2) * Real.log (q / (q - 1)) ≤ (2 * m - 3) * (1 / q) := by
  have h := log_div_sub_one_sub_inv_le (p := q) (by linarith)
  have hq0 : 0 < q := by linarith
  have hq2 : 0 < q - 2 := by linarith
  have hm2 : 0 ≤ 2 * (m - 2) := by linarith
  have e : (1 / 4 : ℝ) * (1 / (q - 2) - 1 / q) = 1 / (2 * q * (q - 2)) := by
    field_simp
    ring
  have hk : 2 * (m - 2) * (1 / (2 * q * (q - 2))) ≤ 1 / q := by
    rw [show 2 * (m - 2) * (1 / (2 * q * (q - 2))) = (m - 2) / (q * (q - 2)) by
      field_simp]
    rw [div_le_div_iff₀ (by positivity) hq0]
    nlinarith
  have h1 : 2 * (m - 2) * (Real.log (q / (q - 1)) - 1 / q) ≤ 2 * (m - 2) * (1 / (2 * q * (q - 2))) :=
    mul_le_mul_of_nonneg_left (e ▸ h) hm2
  have e2 : (2 * m - 3) * (1 / q) = 2 * (m - 2) * (1 / q) + 1 / q := by ring
  rw [e2]
  linarith

/-- The stopping test is sound: if every prime of `R` is at least `m ≥ 3` and
`λ/10^15 < u/10^15 + ∑_R log(q/(q-1))`, a passed test gives `t/10^15 < r/10^15 + ∑_R 1/q`. -/
private theorem sixEarly_sound {t m r u : ℕ} (R : Finset ℕ) (hm : 3 ≤ m) (hR : ∀ q ∈ R, m ≤ q)
    (hlog : (693147180300000 : ℝ) / 1000000000000000 <
      (u : ℝ) / 1000000000000000 + ∑ q ∈ R, Real.log ((q : ℝ) / (q - 1)))
    (he : sixEarly t m r u = true) :
    (t : ℝ) / 1000000000000000 < (r : ℝ) / 1000000000000000 + ∑ q ∈ R, 1 / (q : ℝ) := by
  set X := ∑ q ∈ R, 1 / (q : ℝ) with hX
  set Y := ∑ q ∈ R, Real.log ((q : ℝ) / (q - 1)) with hY
  have hm' : (3 : ℝ) ≤ m := by exact_mod_cast hm
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun q _ => by positivity
  have hXY : 2 * ((m : ℝ) - 2) * Y ≤ (2 * m - 3) * X := by
    rw [hX, hY, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun q hq => ?_
    exact two_mul_log_div_sub_one_le_six hm' (by exact_mod_cast hR q hq)
  have hM : (0 : ℝ) < 1000000000000000 := by norm_num
  suffices hs : (t : ℝ) < r + 1000000000000000 * X by
    have := div_lt_div_of_pos_right hs hM
    rwa [add_div, mul_div_cancel_left₀ _ hM.ne'] at this
  have hlog' : (693147180300000 : ℝ) < u + 1000000000000000 * Y := by
    have := mul_lt_mul_of_pos_left hlog hM
    rw [mul_add, mul_div_cancel₀ _ hM.ne', mul_div_cancel₀ _ hM.ne'] at this
    exact this
  simp only [sixEarly, Bool.or_eq_true, decide_eq_true_eq] at he
  rcases he with he | he
  · have : (t : ℝ) < r := by exact_mod_cast he
    nlinarith
  · have he' : (2 * m * t + 2 * m * u + 3 * r + 4 * 693147180300000 : ℝ) ≤
        2 * m * r + 2 * m * 693147180300000 + 3 * t + 4 * u := by exact_mod_cast he
    have h2 : (2 * (m : ℝ) - 4) * (693147180300000 - u) <
        (2 * (m : ℝ) - 4) * (1000000000000000 * Y) :=
      mul_lt_mul_of_pos_left (by linarith) (by linarith)
    have h3 : (2 * (m : ℝ) - 4) * (1000000000000000 * Y) ≤
        (2 * (m : ℝ) - 3) * (1000000000000000 * X) := by
      have := mul_le_mul_of_nonneg_left hXY hM.le
      linarith
    have h4 : (2 * (m : ℝ) - 3) * (t - r) < (2 * (m : ℝ) - 3) * (1000000000000000 * X) := by
      linarith
    have h5 := lt_of_mul_lt_mul_left h4 (by linarith)
    linarith

/-- The soundness of `sixCheck`, for a set `R` of undecided primes, all at least the next bound,
which contains the entries of `req` from the next bound on and no entry of `exc`. -/
private theorem sixCheck_sound (t B K : ℕ) (req exc : List ℕ) (hB : 3 ≤ B) :
    ∀ (l : List (ℕ × ℕ × ℕ)) (r u : ℕ) (R : Finset ℕ), sixCheck t B req exc l r u = true →
      sixGap K B l = true → (∀ a ∈ l, 3 ≤ a.1) →
      (∀ a ∈ l, Real.log ((a.1 : ℝ) / (a.1 - 1)) ≤ (a.2.2 : ℝ) / 1000000000000000) →
      (∀ q ∈ R, q.Prime ∧ sixNext B l ≤ q) →
      (∀ p ∈ req, sixNext B l ≤ p → p ∈ R) → (∀ p ∈ exc, p ∉ R) →
      (693147180300000 : ℝ) / 1000000000000000 <
        (u : ℝ) / 1000000000000000 + ∑ q ∈ R, Real.log ((q : ℝ) / (q - 1)) →
      (t : ℝ) / 1000000000000000 < (r : ℝ) / 1000000000000000 + ∑ q ∈ R, 1 / (q : ℝ) := by
  intro l
  induction l with
  | nil =>
    intro r u R hc _ _ _ hR _ _ hlog
    exact sixEarly_sound R hB (fun q hq => (hR q hq).2) hlog hc
  | cons a l ih =>
    intro r u R hc hgap h3 htab hR hreq hexc hlog
    have ha3 := h3 a List.mem_cons_self
    have h3' : ∀ b ∈ l, 3 ≤ b.1 := fun b hb => h3 b (List.mem_cons_of_mem _ hb)
    have htab' : ∀ b ∈ l, Real.log ((b.1 : ℝ) / (b.1 - 1)) ≤ (b.2.2 : ℝ) / 1000000000000000 :=
      fun b hb => htab b (List.mem_cons_of_mem _ hb)
    simp only [sixGap, Bool.and_eq_true, decide_eq_true_eq] at hgap
    obtain ⟨⟨hnext, hgapa⟩, hgap'⟩ := hgap
    have hge : ∀ q ∈ R, a.1 ≤ q := fun q hq => (hR q hq).2
    have hR' : ∀ q ∈ R, q ≠ a.1 → q.Prime ∧ sixNext B l ≤ q := by
      intro q hq hqa
      refine ⟨(hR q hq).1, ?_⟩
      by_contra hlt
      have hlt' : a.1 < q := lt_of_le_of_ne (hge q hq) (Ne.symm hqa)
      exact not_prime_of_sixGapAt _ _ hgapa (by omega) q (by omega) (by omega) (hR q hq).1
    have hreqR : ∀ p ∈ req, sixNext B l ≤ p → p ∈ R ∧ p ≠ a.1 := by
      intro p hp hle
      exact ⟨hreq p hp (show a.1 ≤ p by omega), by omega⟩
    simp only [sixCheck, Bool.or_eq_true, Bool.and_eq_true, List.contains_iff_mem] at hc
    rcases hc with he | ⟨h1, h2⟩
    · exact sixEarly_sound R ha3 hge hlog he
    · by_cases hp : a.1 ∈ R
      · have h2' := h2.resolve_left (fun hm => hexc a.1 hm hp)
        have hsum := Finset.add_sum_erase R (fun q : ℕ => 1 / (q : ℝ)) hp
        have hlsum := Finset.add_sum_erase R (fun q : ℕ => Real.log ((q : ℝ) / (q - 1))) hp
        have hU := htab a List.mem_cons_self
        have hlog' : (693147180300000 : ℝ) / 1000000000000000 <
            ((u + a.2.2 : ℕ) : ℝ) / 1000000000000000 +
              ∑ q ∈ R.erase a.1, Real.log ((q : ℝ) / (q - 1)) := by
          push_cast
          rw [add_div]
          linarith
        have := ih (r + 1000000000000000 / a.1) (u + a.2.2) (R.erase a.1) h2' hgap' h3' htab'
          (fun q hq => hR' q (Finset.mem_of_mem_erase hq) (Finset.ne_of_mem_erase hq))
          (fun p hp hle => Finset.mem_erase.mpr ⟨(hreqR p hp hle).2, (hreqR p hp hle).1⟩)
          (fun p hp hm => hexc p hp (Finset.mem_of_mem_erase hm)) hlog'
        have hp0 : (0 : ℝ) < a.1 := by exact_mod_cast (by omega : 0 < a.1)
        have hfl : ((1000000000000000 / a.1 : ℕ) : ℝ) / 1000000000000000 ≤ 1 / (a.1 : ℝ) := by
          have hmul : ((1000000000000000 / a.1 : ℕ) : ℝ) * a.1 ≤ 1000000000000000 := by
            exact_mod_cast Nat.div_mul_le_self 1000000000000000 a.1
          rw [div_le_div_iff₀ (by norm_num) hp0]
          linarith
        push_cast at this
        rw [add_div] at this
        rw [← hsum]
        linarith
      · have h1' := h1.resolve_left (fun hm => hp (hreq a.1 hm (by simp [sixNext])))
        exact ih r u R h1' hgap' h3' htab'
          (fun q hq => hR' q hq (fun hqa => hp (hqa ▸ hq)))
          (fun p hp hle => (hreqR p hp hle).1) hexc hlog

private theorem sixTable_head : sixNext 10000 sixTable = 3 ∧
    sixTable.all (fun a => decide (3 ≤ a.1)) = true := by
  decide +kernel

private theorem sixTable_gap : sixGap 101 10000 sixTable = true := by
  decide +kernel

private theorem sixTable_up :
    sixTable.all (fun a => decide (recipFourLogUp a.1 a.2.1 ≤ (a.2.2 : ℚ) / 1000000000000000)) =
      true := by
  decide +kernel

private theorem sixCheck_three_not_five :
    sixCheck 604707640000000 10000 [3] [5] sixTable 0 0 = true := by
  decide +kernel

private theorem sixCheck_five_not_three :
    sixCheck 647649660000000 10000 [5] [3] sixTable 0 0 = true := by
  decide +kernel

/-- The transfer from a passed check to the reciprocal sum, for the case lists `req` (primes
that divide `N`) and `exc` (primes that do not). -/
private theorem lt_sum_inv_of_sixCheck {N : ℕ} (h : OddPerfect N) (t : ℕ) (req exc : List ℕ)
    (hreq : ∀ p ∈ req, p ∈ N.primeFactors) (hexc : ∀ p ∈ exc, p ∉ N.primeFactors)
    (hc : sixCheck t 10000 req exc sixTable 0 0 = true) :
    (t : ℝ) / 1000000000000000 < ∑ p ∈ N.primeFactors, 1 / (p : ℝ) := by
  obtain ⟨hhead, hall⟩ := sixTable_head
  have hge3 : ∀ a ∈ sixTable, 3 ≤ a.1 := by
    rw [List.all_eq_true] at hall
    exact fun a ha => of_decide_eq_true (hall a ha)
  have htab : ∀ a ∈ sixTable,
      Real.log ((a.1 : ℝ) / (a.1 - 1)) ≤ (a.2.2 : ℝ) / 1000000000000000 := by
    have := sixTable_up
    rw [List.all_eq_true] at this
    intro a ha
    refine (log_div_sub_one_le_recipFourLogUp_six (by have := hge3 a ha; omega) a.2.1).trans ?_
    have := (Rat.cast_le (K := ℝ)).mpr (of_decide_eq_true (this a ha))
    push_cast at this
    exact this
  have hR : ∀ q ∈ N.primeFactors, q.Prime ∧ sixNext 10000 sixTable ≤ q := by
    intro q hq
    have hqp := Nat.prime_of_mem_primeFactors hq
    refine ⟨hqp, ?_⟩
    rw [hhead]
    have hq2 : q ≠ 2 := by
      rintro rfl
      exact (Nat.not_even_iff_odd.mpr h.odd)
        (even_iff_two_dvd.mpr (Nat.dvd_of_mem_primeFactors hq))
    have := hqp.two_le
    omega
  have hlog : (693147180300000 : ℝ) / 1000000000000000 <
      ((0 : ℕ) : ℝ) / 1000000000000000 +
        ∑ q ∈ N.primeFactors, Real.log ((q : ℝ) / (q - 1)) := by
    have h1 := log_two_lt_sum_log h
    have h2 := Real.log_two_gt_d9
    norm_num at h2 ⊢
    linarith
  have := sixCheck_sound t 10000 101 req exc (by norm_num) sixTable 0 0 N.primeFactors
    hc sixTable_gap hge3 htab hR (fun p hp _ => hreq p hp) hexc hlog
  simpa using this

private theorem mem_primeFactors_six {N p : ℕ} (h : OddPerfect N) (hp : p.Prime) (hd : p ∣ N) :
    p ∈ N.primeFactors :=
  Nat.mem_primeFactors.mpr ⟨hp, hd, h.ne_zero⟩

/-- For an odd perfect number divisible by `3` and not by `5`, `0.60470764 < ∑_{p ∣ N} 1/p`.
Cohen (1980, Theorem 1 (iv)) proves `S₂(3, 7, 11, 29, 331; 337)`, about `0.60470749`. -/
theorem sum_inv_gt_60470764_of_three_not_five {N : ℕ} (h : OddPerfect N) (h3 : 3 ∣ N)
    (h5 : ¬ 5 ∣ N) : (60470764 / 100000000 : ℝ) < ∑ p ∈ N.primeFactors, 1 / (p : ℝ) := by
  have := lt_sum_inv_of_sixCheck h 604707640000000 [3] [5]
    (by
      intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      subst hp
      exact mem_primeFactors_six h Nat.prime_three h3)
    (by
      intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      subst hp
      exact fun hm => h5 (Nat.dvd_of_mem_primeFactors hm))
    sixCheck_three_not_five
  norm_num at this ⊢
  linarith

/-- For an odd perfect number divisible by `5` and not by `3`, `0.64764966 < ∑_{p ∣ N} 1/p`.
Cohen (1980, Theorem 1 (i)) proves `S₂(5, ..., 19, 41, 907; 911)`, about `0.647649654`. -/
theorem sum_inv_gt_64764966_of_five_not_three {N : ℕ} (h : OddPerfect N) (h3 : ¬ 3 ∣ N)
    (h5 : 5 ∣ N) : (64764966 / 100000000 : ℝ) < ∑ p ∈ N.primeFactors, 1 / (p : ℝ) := by
  have := lt_sum_inv_of_sixCheck h 647649660000000 [5] [3]
    (by
      intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      subst hp
      exact mem_primeFactors_six h Nat.prime_five h5)
    (by
      intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      subst hp
      exact fun hm => h3 (Nat.dvd_of_mem_primeFactors hm))
    sixCheck_five_not_three
  norm_num at this ⊢
  linarith

end OddPerfect

#print axioms OddPerfect.sum_inv_gt_60470764_of_three_not_five
