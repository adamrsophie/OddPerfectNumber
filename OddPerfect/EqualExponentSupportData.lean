/-- The thirteen certified primes, or `179`, `197`, cover the primes from `131` to `201`. -/
theorem support_cases_of_prime {l : ℕ} (hl : l.Prime) (h1 : 131 ≤ l) (h2 : l ≤ 201) :
    (l = 131 ∨ l = 137 ∨ l = 139 ∨ l = 149 ∨ l = 151 ∨ l = 157 ∨ l = 163 ∨ l = 167 ∨ l = 173 ∨
      l = 181 ∨ l = 191 ∨ l = 193 ∨ l = 199) ∨ l = 179 ∨ l = 197 := by
  interval_cases l <;> first | decide | exact absurd hl (by norm_num)

/-- The geometric sum bound used for the special prime: `∑ j < 50, (10 ^ 6) ^ j` is below
`(2 l + 1) ^ (l - 1)` for every `l ≥ 131`. -/
theorem geom_lt_of_le {l : ℕ} (hl : 131 ≤ l) :
    ∑ j ∈ Finset.range (49 + 1), (10 ^ 6) ^ j < (2 * l + 1) ^ (l - 1) := by
  have h0 : ∑ j ∈ Finset.range (49 + 1), (10 ^ 6 : ℕ) ^ j < 263 ^ 130 := by decide +kernel
  calc _ < 263 ^ 130 := h0
    _ ≤ (2 * l + 1) ^ 130 := Nat.pow_le_pow_left (by omega) 130
    _ ≤ (2 * l + 1) ^ (l - 1) := Nat.pow_le_pow_right (by omega) (by omega)

/-- The certified cases. In the family where every ordinary exponent equals `l - 1`, an Euler
index with at most five prime factors and a special prime above `10 ^ 6` are impossible for
the thirteen certified primes `l`. Restricted result; no published source was checked;
novelty not verified. -/
theorem false_of_support_cases {N q a m l : ℕ} (h : OddPerfect N) (hq : q.Prime)
    (hN : N = q ^ a * m ^ 2) (hqm : ¬ q ∣ m) (hl : l.Prime) (hl2 : l ≠ 2)
    (hexp : ∀ p ∈ N.primeFactors, p ≠ q → N.factorization p = l - 1)
    (hJ : (eulerIndex q a m).primeFactors.card ≤ 5) (hB : 10 ^ 6 < q)
    (hcase : l = 131 ∨ l = 137 ∨ l = 139 ∨ l = 149 ∨ l = 151 ∨ l = 157 ∨ l = 163 ∨ l = 167 ∨
      l = 173 ∨ l = 181 ∨ l = 191 ∨ l = 193 ∨ l = 199) : False := by
  rcases hcase with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check131
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check137
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check139
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check149
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check151
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check157
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check163
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check167
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check173
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check181
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check191
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check193
  · exact supportCheck_sound (k := 5) h hq hN hqm hl hl2 hexp hJ hB check199

end OddPerfect.EqSupport

