open ExcessFourS1

/-- Exclusion S1: no odd perfect number with special prime `q` has exponent 6 at 3, at most one
further prime `r` of exponent 4, every other prime factor except `q` of exponent 2. This
concerns only this restricted family, not odd perfect numbers in general. -/
theorem excessS1 : ExcessS1 := by
  intro N q r h hq hodd h3 hr hsq
  exact checkV_sound (defSound paramsS1) prS1_sound (fun _ _ _ _ hd _ => Bool.false_ne_true hd)
    (fun hl => absurd hl (by decide)) certS1_ok
    (famV_S1 (P := paramsS1) rfl (by decide) h hq hodd h3 hr hsq)

end OddPerfect

