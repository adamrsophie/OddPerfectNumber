theorem prattS1_ok : Pratt.check prattS1 = true := by decide +kernel

/-- A search tree over the primes of `prattS1`. -/
def treeS1 : PTree := (.node (.node (.node (.node (.node .leaf 101 .leaf) 131 (.node .leaf 151 .leaf)) 167 (.node (.node .leaf 173 .leaf) 251 (.node .leaf 947 .leaf))) 971 (.node (.node (.node .leaf 4519 .leaf) 5113 (.node .leaf 5419 .leaf)) 5827 (.node (.node .leaf 8011 .leaf) 8269 .leaf))) 10303 (.node (.node (.node (.node .leaf 13267 .leaf) 16651 (.node .leaf 17293 .leaf)) 19441 (.node (.node .leaf 24623 .leaf) 28057 .leaf)) 30103 (.node (.node (.node .leaf 147739 .leaf) 398581 (.node .leaf 990151 .leaf)) 3348577 (.node (.node .leaf 8715961 .leaf) 3737657091169 .leaf))))

theorem treeS1_toList : treeS1.toList = prattS1.map Prod.fst := by decide +kernel

/-- The primality oracle: the verified table below 4096, the search tree from 4096 on. -/
def prS1 (n : ℕ) : Bool := cond (Nat.blt n 4096) (primeB n) (treeS1.mem n)

/-- Soundness of the oracle. -/
theorem prS1_sound : ∀ n, prS1 n = true → n.Prime := by
  intro n h
  unfold prS1 at h
  cases hb : Nat.blt n 4096
  · simp only [hb, cond_false] at h
    have hm := PTree.mem_toList h
    rw [treeS1_toList] at hm
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
    exact Pratt.check_sound prattS1_ok e he
  · simp only [hb, cond_true] at h
    exact primeB_sound h

