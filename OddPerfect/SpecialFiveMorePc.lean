import OddPerfect.SpecialFiveMoreLemmas
import OddPerfect.SpecialFiveMorePratt0
import OddPerfect.SpecialFiveMorePratt1
import OddPerfect.SpecialFiveMorePratt2
import OddPerfect.SpecialFiveMorePratt3
import OddPerfect.SpecialFiveMorePratt4
import OddPerfect.SpecialFiveMorePratt5

/-!
# Pratt certificate for `SpecialFiveMore`: the chunks glued

The flat Pratt certificate `pratt` is the concatenation of the 6 chunks.
Each chunk was checked with a list of known primes; here each such list is
checked to consist of primes of earlier chunks, and `check_append` glues.

Generated by `scripts/SpecialFiveMore/gen.py 33 OUTDIR` (see the README there).
Ochem and Rao (Math. Comp. 81, 2012) proved that every odd perfect number has a
component above `10 ^ 62`; this certificate is a machine checked special case. The
odd perfect number conjecture remains open.
-/

namespace OddPerfect

namespace SpecialFiveMore

open DefectTree (Tab PCert tabOK)
open SpecialFive (Cert Mode go)

-- Check the theorems one after the other: in parallel their kernel checks raise the
-- peak memory.
set_option Elab.async false

/-- The flat Pratt certificate. -/
def pratt : PCert :=
  prattC0 ++ prattC1 ++ prattC2 ++ prattC3 ++ prattC4 ++ prattC5

/-- The first chunk is accepted. -/
theorem prattP0_ok : Pratt.check prattC0 = true := prattC0_ok

/-- The first 2 chunks are accepted. -/
theorem prattP1_ok :
    Pratt.check (prattC0 ++ prattC1) = true :=
  check_append prattP0_ok prattC1_ok (by decide +kernel)

/-- The first 3 chunks are accepted. -/
theorem prattP2_ok :
    Pratt.check ((prattC0 ++ prattC1) ++ prattC2) = true :=
  check_append prattP1_ok prattC2_ok (by decide +kernel)

/-- The first 4 chunks are accepted. -/
theorem prattP3_ok :
    Pratt.check (((prattC0 ++ prattC1) ++ prattC2) ++ prattC3) = true :=
  check_append prattP2_ok prattC3_ok (by decide +kernel)

/-- The first 5 chunks are accepted. -/
theorem prattP4_ok :
    Pratt.check ((((prattC0 ++ prattC1) ++ prattC2) ++ prattC3) ++ prattC4) = true :=
  check_append prattP3_ok prattC4_ok (by decide +kernel)

/-- The first 6 chunks are accepted. -/
theorem prattP5_ok :
    Pratt.check (((((prattC0 ++ prattC1) ++ prattC2) ++ prattC3) ++ prattC4) ++ prattC5) = true :=
  check_append prattP4_ok prattC5_ok (by decide +kernel)

/-- The flat Pratt certificate is accepted. -/
theorem pratt_ok : Pratt.check pratt = true := prattP5_ok

end SpecialFiveMore

end OddPerfect

