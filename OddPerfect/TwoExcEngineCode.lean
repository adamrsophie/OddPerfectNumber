import OddPerfect.Pratt

/-!
# A certificate checker for families "at most E exceptional primes, fixed exponent at 3": code

This module holds only the computable part of the engine: the search state, the certificate
term and the Boolean checkers `go`, `check` (exponent 2 at 3) and `checkV` (exponent `V3` at
3 given by the parameters, with `3` an exception of exact exponent `V3` when `V3 ≠ 2`, and
every other exception of exponent exactly 4 when `e4`). It imports nothing but `OddPerfect.Pratt`, so that
data modules that only evaluate the checker load quickly. The meaning of a state and the
soundness theorem live in later modules. The engine is a tool: an accepted certificate refutes
exactly the states it is run on, nothing more.

## The state

A state is a number `x` and a list of keys. A key is a prime `p` with a role and a list of
contributions `(c, w)`.

* `x`: every prime below `x` that is not a key does not divide `N`. The number `x` need not be
  prime. The checker moves `x` only by its own scan (`scanNext`), which skips keys and numbers
  that are not prime (by a verified table below 4096, by a found divisor above), so no prime
  is ever skipped.
* A role is `sq` (exponent exactly 2) or `fr isQ D no3 kmin exact` (a free prime: the special
  prime when `isQ`, otherwise an exception; its exponent `k` has `D ∣ k + 1`, `kmin ≤ k`,
  `3 ∤ k + 1` when `no3`, and `k = kmin` when `exact`).
* A contribution `(c, w)` on the key `p` says `p ^ w ∣ σ(c ^ v_c(N))`. The components `c` of one
  key are distinct, so the contributions of a key sum to at most `v_p(N)`.

## How items are verified

An item `(p, e)` of a record whose component is `c` adds `e` to the weight of `(p, c)`. The
merged weight `w` is checked directly as `p ^ w ∣ σ(c ^ m)` where `m` is `2` for a square,
`kmin` for an exact free prime and `D - 1` otherwise, by one modular power
`c ^ (m + 1) ≡ 1 (mod p ^ w (c - 1))`. Since `σ(c ^ m)` divides `σ(c ^ v_c(N))` this justifies
the merged weight. The certificate values `Φ_d(c)` themselves are never needed.

## Kernel cost

The functions evaluated many times (key lookups, items, the scan, the enumeration of a
deficient leaf) are written with `Nat.rec`, `List.rec`, `cond` and the kernel accelerated
primitives `Nat.add`, `Nat.mul`, `Nat.mod`, `Nat.beq`, `Nat.ble`, `Nat.blt`, `Nat.land` and
`Nat.shiftRight`, which the kernel evaluates several times faster than structural recursion
with type class arithmetic.
-/

namespace OddPerfect

namespace TwoExcEngine

/-- Checker parameters, read from the certificate header: the number `E` of allowed
exceptions, the enumeration limit `MHIT`, the exponent cap `KCAP`, whether the landed facts
on the special prime and rule L are used, the exponent `V3` of 3, and whether every exception
has exponent exactly 4 (`e4`). The defaults `V3 = 2` and `e4 = false` give the family with
exponent 2 at 3 and exceptions of any admissible exponent. When `V3 ≠ 2` the prime 3 is an
exception key of exact exponent `V3`, so it counts towards `E`. -/
structure Params where
  E : ℕ
  MHIT : ℕ
  KCAP : ℕ
  landed : Bool
  V3 : ℕ := 2
  e4 : Bool := false
  deriving DecidableEq, Repr

/-- The landed facts are used: they need exponent 2 at 3. -/
def Params.lan (P : Params) : Bool := P.landed && P.V3 == 2

/-- The role of a key: a square prime, or a free prime with its exponent data. -/
inductive Role where
  | sq : Role
  | fr (isQ : Bool) (D : ℕ) (no3 : Bool) (kmin : ℕ) (exact : Bool) : Role
  deriving DecidableEq, Repr

/-- A key: a prime `p` of `N`, its role and its contributions `(component, weight)`. -/
structure Key where
  p : ℕ
  role : Role
  cs : List (ℕ × ℕ)
  deriving DecidableEq, Repr

/-- Data of a deficient leaf: the Rankin exponent `k`, the base `B` of the rational weights
(`α_g = B / r_g`), the numbers `r_g` for the generators of `K` in key order, `r_x`, the
witnesses `mL` and `mM` as (numerator, denominator), and composite witnesses `(t, w)` for the
candidates that are not prime. -/
structure DefData where
  k : ℕ
  B : ℕ
  rs : List ℕ
  rx : ℕ
  mL : ℕ × ℕ
  mM : ℕ × ℕ
  comps : List (ℕ × ℕ)
  deriving DecidableEq, Repr

/-- The certificate term. It carries only the tree shape, the items `(p, e)` of each record,
the receiver and sender choices with their orders `d`, the split primes and the deficient leaf
data; the checker derives every state. Children are chained with `cons` and `nil`. -/
inductive Cert where
  /-- A record whose items produce a contradiction (cap, capexact, absentforced). -/
  | leaf : Cert
  /-- The listed divisor of the state is abundant. -/
  | abundant : Cert
  /-- Rule L fails. -/
  | landedL : Cert
  /-- A record: its own items and its outcome. -/
  | apply (items : List (ℕ × ℕ)) (out : Cert) : Cert
  /-- Branch on the roles of the least pending prime. -/
  | force (children : Cert) : Cert
  /-- End of a chain. -/
  | nil : Cert
  /-- A chain. -/
  | cons (hd tl : Cert) : Cert
  /-- The sender rule at the receiver `p`. -/
  | receipt (p : ℕ) (senders : Cert) : Cert
  /-- The free prime `g` cannot send to the receiver; `d` is the order. -/
  | inf (g d : ℕ) : Cert
  /-- The free prime `g` sends to the receiver; `d` is the order. -/
  | snd (g d : ℕ) (child : Cert) : Cert
  /-- No item is pending; continue with a step. -/
  | closed (step : Cert) : Cert
  /-- Decide the next undecided prime: its roles, then its absence. -/
  | decide (children absent : Cert) : Cert
  /-- A deficient leaf at the next undecided prime. -/
  | check (dd : DefData) : Cert
  /-- Rule L fails at the next undecided prime. -/
  | checkL : Cert
  /-- Split the exponent of the free prime `p`: exact or larger. -/
  | split (p : ℕ) (ex atl : Cert) : Cert
  /-- The state is refuted elsewhere (`done`). -/
  | ext : Cert
  deriving Repr

/-! ## Small arithmetic -/

/-- `findDiv f n d`: the least divisor `d' ≥ d` of `n` with `d' * d' ≤ n`, or `n` when there is
none; `0` when the fuel runs out. -/
def findDiv (f : ℕ) : ℕ → ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ) (fun _ _ => 0)
    (fun _ ih n d => cond (Nat.blt n (Nat.mul d d)) n
      (cond (Nat.beq (Nat.mod n d) 0) d (ih n (Nat.add d 1)))) f

/-- Primality by trial division up to the square root, for `n < 2 ^ 32` (fuel 65536; a larger
`n` may be reported not prime, which is always safe for the callers). -/
def smallPrime (n : ℕ) : Bool := Nat.ble 2 n && Nat.beq (findDiv 65536 n 2) n

/-- Bit `i` of `PMASK` is set exactly when `i < 4096` is prime (checked once by `pmask_ok` in a
later module). -/
def PMASK : ℕ := 

/-- Primality of a number below 4096 by the table, of a larger one by trial division. -/
def primeB (n : ℕ) : Bool :=
  cond (Nat.blt n 4096) (Nat.beq (Nat.land (Nat.shiftRight PMASK n) 1) 1) (smallPrime n)

/-- `sig p e = 1 + p + ⋯ + p ^ e` for `p ≥ 2`. -/
def sig (p e : ℕ) : ℕ := (p ^ (e + 1) - 1) / (p - 1)

/-- Binary modular exponentiation: `powModR n f b e acc = acc * b ^ e % n` when `e < 2 ^ f`;
the callers use the fuel `e + 1`. -/
def powModR (n f : ℕ) : ℕ → ℕ → ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ → ℕ → ℕ) (fun _ _ acc => Nat.mod acc n)
    (fun _ ih b e acc => cond (Nat.beq e 0) (Nat.mod acc n)
      (ih (Nat.mod (Nat.mul b b) n) (Nat.div e 2)
        (cond (Nat.beq (Nat.mod e 2) 1) (Nat.mod (Nat.mul acc b) n) acc))) f

/-- `b ^ e % n`. -/
def powModE (b e n : ℕ) : ℕ := powModR n (Nat.add e 1) b e 1

/-- Trial division factor list (with multiplicity), with fuel. Its result is checked. -/
def pfacsAux : ℕ → ℕ → ℕ → List ℕ
  | 0, m, _ => if 1 < m then [m] else []
  | f + 1, m, r =>
    if m < 2 then [] else if m < r * r then [m]
    else if m % r == 0 then r :: pfacsAux f (m / r) r else pfacsAux f m (r + 1)

/-- The prime factors of `d` with multiplicity, by trial division. -/
def pfacs (d : ℕ) : List ℕ := pfacsAux (2 * d + 10) d 2

/-- `d` is the multiplicative order of `g` modulo `p`, or `d = p` when `g ≡ 1 (mod p)`. -/
def ordOK (d g p : ℕ) : Bool :=
  if g % p == 1 then d == p
  else
    let fs := pfacs d
    1 ≤ d && powModE g d p == 1 % p && fs.prod == d && fs.all primeB &&
      fs.all (fun r => powModE g (d / r) p != 1 % p)

/-! ## Keys -/

/-- The key of `p`, if any. -/
def findKey (p : ℕ) (ks : List Key) : Option Key :=
  List.rec (motive := fun _ => Option Key) none (fun k _ ih => cond (Nat.beq k.p p) (some k) ih) ks

/-- `p` is a key. -/
def isKey (ks : List Key) (p : ℕ) : Bool :=
  List.rec (motive := fun _ => Bool) false (fun k _ ih => cond (Nat.beq k.p p) true ih) ks

/-- Insert a key in increasing order of its prime. -/
def insertKey (k : Key) (ks : List Key) : List Key :=
  List.rec (motive := fun _ => List Key) [k]
    (fun k' l ih => cond (Nat.blt k.p k'.p) (k :: k' :: l) (k' :: ih)) ks

/-- Replace the key with the prime of `k`. -/
def replaceKey (k : Key) (ks : List Key) : List Key :=
  List.rec (motive := fun _ => List Key) []
    (fun k' l ih => cond (Nat.beq k'.p k.p) (k :: l) (k' :: ih)) ks

/-- Change the role of the key `p`. -/
def setRole (p : ℕ) (r : Role) (ks : List Key) : List Key :=
  List.rec (motive := fun _ => List Key) []
    (fun k l ih => cond (Nat.beq k.p p) (⟨k.p, r, k.cs⟩ :: l) (k :: ih)) ks

/-- The weight of component `c` in a contribution list. -/
def lookupW (c : ℕ) (l : List (ℕ × ℕ)) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0 (fun e _ ih => cond (Nat.beq e.1 c) e.2 ih) l

/-- Set the weight of component `c`. -/
def setW (c w : ℕ) (l : List (ℕ × ℕ)) : List (ℕ × ℕ) :=
  List.rec (motive := fun _ => List (ℕ × ℕ)) [(c, w)]
    (fun e l' ih => cond (Nat.beq e.1 c) ((c, w) :: l') (e :: ih)) l

/-- The sum of the weights. -/
def csum (l : List (ℕ × ℕ)) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0 (fun e _ ih => Nat.add e.2 ih) l

/-- The weight of the pending pair `(p, c)`. -/
def lookupP (p c : ℕ) (l : List (ℕ × ℕ × ℕ)) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0
    (fun e _ ih => cond (Nat.beq e.1 p && Nat.beq e.2.1 c) e.2.2 ih) l

/-- Set the weight of the pending pair `(p, c)`. -/
def setP (p c w : ℕ) (l : List (ℕ × ℕ × ℕ)) : List (ℕ × ℕ × ℕ) :=
  List.rec (motive := fun _ => List (ℕ × ℕ × ℕ)) [(p, c, w)]
    (fun e l' ih => cond (Nat.beq e.1 p && Nat.beq e.2.1 c) ((p, c, w) :: l') (e :: ih)) l

/-- The exponent `m` with `σ(c ^ m) ∣ σ(c ^ v_c(N))` guaranteed by a role. -/
def Role.m : Role → ℕ
  | .sq => 2
  | .fr _ D _ kmin ex => cond ex kmin (Nat.sub D 1)

/-- `n ∣ σ(c ^ m)` for the role exponent `m` of the key `c`, tested as
`c ^ (m + 1) ≡ 1 (mod n (c - 1))`. -/
def gdivB (ks : List Key) (c n : ℕ) : Bool :=
  match findKey c ks with
  | none => false
  | some k =>
    let M := Nat.mul n (Nat.sub c 1)
    Nat.ble 2 c && Nat.beq (powModE c (Nat.add k.role.m 1) M) (Nat.mod 1 M)

/-- A key whose contributions exceed its budget (2 for a square, `kmin` for an exact free prime). -/
def overBudget (k : Key) : Bool :=
  match k.role with
  | .sq => Nat.blt 2 (csum k.cs)
  | .fr _ _ _ kmin ex => ex && Nat.blt kmin (csum k.cs)

/-- The special prime is a key. -/
def qDec (ks : List Key) : Bool :=
  ks.any fun k => match k.role with | .fr true _ _ _ _ => true | _ => false

/-- The number of exception keys. -/
def nexc : List Key → ℕ
  | [] => 0
  | k :: ks => (match k.role with | .fr false _ _ _ _ => 1 | _ => 0) + nexc ks

/-! ## Items -/

/-- The result of applying items. -/
inductive Res where
  | rej : Res
  | contra : Res
  | ok (ks : List Key) (pend : List (ℕ × ℕ × ℕ)) : Res

/-- Apply one item `(p, e)` of component `c`, then continue with `k`. Contradictions: a square
over 2, an exact free prime over `kmin`, or a prime below `x` that is not a key. -/
def applyOne (pr : ℕ → Bool) (x c p e : ℕ) (ks : List Key) (pend : List (ℕ × ℕ × ℕ))
    (k : List Key → List (ℕ × ℕ × ℕ) → Res) : Res :=
  cond (Nat.ble 1 e && Nat.beq (Nat.mod p 2) 1)
    (match findKey p ks with
     | some kp =>
       let w := Nat.add (lookupW c kp.cs) e
       cond (gdivB ks c (p ^ w))
         (let kp' : Key := ⟨kp.p, kp.role, setW c w kp.cs⟩
          cond (overBudget kp') .contra (k (replaceKey kp' ks) pend))
         .rej
     | none =>
       let w := Nat.add (lookupP p c pend) e
       cond (gdivB ks c (p ^ w))
         (cond (Nat.blt p x) (cond (pr p) .contra .rej) (k ks (setP p c w pend)))
         .rej)
    .rej

/-- Apply the items of component `c` in order. -/
def applyItems (pr : ℕ → Bool) (x c : ℕ) (items : List (ℕ × ℕ)) :
    List Key → List (ℕ × ℕ × ℕ) → Res :=
  List.rec (motive := fun _ => List Key → List (ℕ × ℕ × ℕ) → Res) (fun ks pend => .ok ks pend)
    (fun it _ ih ks pend => applyOne pr x c it.1 it.2 ks pend ih) items

/-- The least pending prime. -/
def pmin : List (ℕ × ℕ × ℕ) → ℕ
  | [] => 0
  | [(p, _, _)] => p
  | (p, _, _) :: l => min p (pmin l)

/-- The pending contributions on `f`. -/
def csOf (f : ℕ) (pend : List (ℕ × ℕ × ℕ)) : List (ℕ × ℕ) :=
  pend.filterMap fun e => if e.1 == f then some (e.2.1, e.2.2) else none

/-- The admissible roles of a prime `f` that divides `N` and is not a key (section 4 of the
format): square; the special prime classes when it is undecided; the exception classes while
fewer than `E` exceptions are listed (when `e4`, the single class of exponent exactly 4 for every
prime other than 3; the prime 3 keeps the general classes, since its exponent is `V3`). -/
def rolesOf (P : Params) (ks : List Key) (f : ℕ) : List Role :=
  [.sq] ++
  (if !qDec ks && f % 4 == 1 && (!P.lan || (f != 5 && f % 9 != 8)) then
    (if f % 3 == 1 then [.fr true 2 true 1 false, .fr true 6 false 5 false]
     else [.fr true 2 P.lan 1 false])
   else []) ++
  (if nexc ks < P.E then
    (if P.e4 && f != 3 then [.fr false 5 true 4 true]
     else if f % 3 == 1 then [.fr false 1 true 4 false, .fr false 3 false 8 false]
     else [.fr false 1 false 4 false])
   else [])

/-- An admissible value `n = k + 1` for a free prime. -/
def allowedB (isQ : Bool) (D : ℕ) (no3 : Bool) (n : ℕ) : Bool :=
  n % D == 0 && (!no3 || n % 3 != 0) && (if isQ then n % 4 == 2 else n % 2 == 1 && 5 ≤ n)

/-- Scan the multiples `D * j` for an admissible value, with fuel. -/
def nextAux (isQ : Bool) (D : ℕ) (no3 : Bool) : ℕ → ℕ → Option ℕ
  | 0, _ => none
  | f + 1, j => if allowedB isQ D no3 (D * j) then some (D * j) else nextAux isQ D no3 f (j + 1)

/-- The least admissible `n ≥ s`, if found within 64 multiples of `D`. -/
def nextAllowed (isQ : Bool) (D : ℕ) (no3 : Bool) (s : ℕ) : Option ℕ :=
  if D == 0 then none else nextAux isQ D no3 64 ((s + D - 1) / D)

/-- A sender `g` with role `r` and order `d` cannot send: its exponent constraints exclude
`lcm D d ∣ k + 1`. -/
def infeasibleB : Role → ℕ → Bool
  | .sq, _ => false
  | .fr isQ D no3 kmin ex, d =>
    let L := Nat.lcm D d
    (ex && (kmin + 1) % L != 0) || (isQ && L % 4 == 0) || (!isQ && L % 2 == 0) ||
      (no3 && L % 3 == 0)

/-- The free keys other than `p`, in key order. -/
def freeOthers (ks : List Key) (p : ℕ) : List ℕ :=
  ks.filterMap fun k => match k.role with
    | .fr _ _ _ _ _ => if k.p == p then none else some k.p
    | .sq => none

/-! ## Closing rules -/

/-- The exponent of a key in the abundant divisor. -/
def abExp (P : Params) : Role → ℕ
  | .sq => 2
  | .fr _ _ _ kmin _ => min kmin P.KCAP

/-- `(∏ σ(p ^ e), ∏ p ^ e)` over the keys. -/
def abPair (P : Params) : List Key → ℕ × ℕ
  | [] => (1, 1)
  | k :: ks =>
    let r := abPair P ks
    (sig k.p (abExp P k.role) * r.1, k.p ^ abExp P k.role * r.2)

/-- The listed divisor is abundant. -/
def abundantB (P : Params) (ks : List Key) : Bool :=
  let r := abPair P ks
  2 * r.2 < r.1

/-- The primes of rule L. -/
def LSET : List ℕ := [7, 13, 19, 31, 61, 97, 127, 331]

/-- Rule L fails: every listed exception in L has `3 ∣ D`, and either the exceptions are
complete or every prime of L is below `x` or a key. -/
def landedLB (P : Params) (ks : List Key) (x : ℕ) : Bool :=
  P.lan && decide (P.E ≤ 2) &&
    LSET.all (fun p => match findKey p ks with
      | some ⟨_, .fr false D _ _ _, _⟩ => D % 3 == 0
      | _ => true) &&
    (nexc ks == P.E || LSET.all fun p => decide (p < x) || isKey ks p)

/-- Scan from `y` for the least prime that is not a key, skipping keys and numbers that are not
prime: below 4096 by the table, above by a found divisor. -/
def scanAux (ks : List Key) (f : ℕ) : ℕ → Option ℕ :=
  Nat.rec (motive := fun _ => ℕ → Option ℕ) (fun _ => none)
    (fun _ ih y => cond (isKey ks y || Nat.blt y 2) (ih (Nat.add y 1))
      (cond (Nat.blt y 4096)
        (cond (Nat.beq (Nat.land (Nat.shiftRight PMASK y) 1) 1) (some y) (ih (Nat.add y 1)))
        (let m := findDiv 65536 y 2
         cond (Nat.beq m y) (some y)
           (cond (Nat.ble 2 m && Nat.blt m y && Nat.beq (Nat.mod y m) 0) (ih (Nat.add y 1))
             none)))) f

/-- The next prime at least `x` that is not a key. -/
def scanNext (ks : List Key) (x : ℕ) : Option ℕ := scanAux ks 1000 x

/-! ## The deficient leaf -/

/-- The square filter: (modulus, mask) pairs, where bit `r` of the mask is set exactly when `r`
is a square modulo the modulus (checked once in a later module). A value that fails one test is
not a square. -/
def qrTable : List (ℕ × ℕ) := [
  (33263, ),
  (7429, ),
  (5005, ),
  (1763, ),
  (2491, ),
  (3599, ),
  (4757, )]

/-- The filter test. -/
def qrPass (z : ℕ) : Bool :=
  List.rec (motive := fun _ => Bool) true
    (fun mm _ ih => cond (Nat.beq (Nat.land (Nat.shiftRight mm.2 (Nat.mod z mm.1)) 1) 1) ih false)
    qrTable

/-- Newton iteration for the integer square root, with fuel. -/
def newton (f z : ℕ) : ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ → ℕ) (fun s => s)
    (fun _ ih s => let s' := Nat.div (Nat.add s (Nat.div z s)) 2; cond (Nat.blt s' s) (ih s') s) f

/-- `some (some s)` with `s * s = z`, `some none` when `z` is not a square (by the filter or by
Newton's result `s` with `s * s < z < (s + 1) * (s + 1)`), and `none` when Newton fails. -/
def sqrtIfSq (z : ℕ) : Option (Option ℕ) :=
  cond (qrPass z)
    (let s := newton 400 z (cond (Nat.blt z (2 ^ 102)) (2 ^ 51) z)
     cond (Nat.beq (Nat.mul s s) z) (some (some s))
       (cond (Nat.blt (Nat.mul s s) z && Nat.blt z (Nat.mul (Nat.add s 1) (Nat.add s 1)))
         (some none) none))
    (some none)

/-- The accumulator of the enumeration: (still accepted, hit numerator, hit denominator). -/
abbrev Acc := Bool × ℕ × ℕ

/-- A square case `4n - 3 = s ^ 2`: when the candidate `t = (s - 1)/2` is odd, `≡ 2 (mod 3)`, at
least `x`, not a key and has no composite witness, it is a hit and `n / t^2` is multiplied in. -/
def visitSq (ks : List Key) (x : ℕ) (comps : List (ℕ × ℕ)) (acc : Acc) (n s : ℕ) : Acc :=
  let t := (s - 1) / 2
  if t % 2 == 0 || t % 3 != 2 || t < x || isKey ks t then acc
  else match comps.lookup t with
    | some w => if 1 < w && w < t && t % w == 0 then acc else (false, acc.2)
    | none => (acc.1, acc.2.1 * n, acc.2.2 * (t * t))

/-- Visit one generated value `n`. -/
def visit (ks : List Key) (x : ℕ) (comps : List (ℕ × ℕ)) (acc : Acc) (n : ℕ) : Acc :=
  let z := Nat.sub (Nat.mul 4 n) 3
  cond (qrPass z)
    (match sqrtIfSq z with
     | none => (false, acc.2)
     | some none => acc
     | some (some s) => visitSq ks x comps acc n s)
    acc

/-- The powers `v, v g, v g^2, …` below `MH`, each passed to `inner`, with fuel. -/
def loopPow (MH g : ℕ) (inner : ℕ → Acc → Acc) (f : ℕ) : ℕ → Acc → Acc :=
  Nat.rec (motive := fun _ => ℕ → Acc → Acc) (fun _ acc => (false, acc.2))
    (fun _ ih v acc => cond (Nat.ble MH v) acc (ih (Nat.mul v g) (inner v acc))) f

/-- Enumerate all products `v ∏ g^e` below `MH` over the generators. -/
def enumG (MH : ℕ) (vis : Acc → ℕ → Acc) : List ℕ → ℕ → Acc → Acc
  | [], v, acc => vis acc v
  | g :: gs, v, acc => loopPow MH g (enumG MH vis gs) 200 v acc

/-- The upper ratio of a key as (numerator, denominator). -/
def hiPair (P : Params) (k : Key) : ℕ × ℕ :=
  match k.role with
  | .sq => (k.p * k.p + k.p + 1, k.p * k.p)
  | .fr _ _ _ kmin ex => if ex && kmin ≤ P.KCAP then (sig k.p kmin, k.p ^ kmin) else (k.p, k.p - 1)

/-- `H` as (numerator, denominator). -/
def hiProd (P : Params) : List Key → ℕ × ℕ
  | [] => (1, 1)
  | k :: ks => let a := hiPair P k; let b := hiProd P ks; (a.1 * b.1, a.2 * b.2)

/-- The remaining capacity of the slot (d): squares `≡ 1 (mod 3)` and exact free primes
`≡ 1 (mod 3)`. -/
def dCap : List Key → ℕ
  | [] => 0
  | k :: ks =>
    (if k.p % 3 == 1 then
      match k.role with
      | .sq => 2 - csum k.cs
      | .fr _ _ _ kmin ex => if ex then kmin - csum k.cs else 0
    else 0) + dCap ks

/-- The generators `K`: non exact free keys `≡ 1 (mod 3)`, in key order. -/
def genK (ks : List Key) : List ℕ :=
  ks.filterMap fun k => match k.role with
    | .fr _ _ _ _ false => if k.p % 3 == 1 then some k.p else none
    | _ => none

/-- `r > B` and `B ^ k g ≥ r ^ k`, for each generator. -/
def alphaOK (k B : ℕ) : List ℕ → List ℕ → Bool
  | [], [] => true
  | g :: gs, r :: rs => decide (B < r) && decide (r ^ k ≤ B ^ k * g) && alphaOK k B gs rs
  | _, _ => false

/-- The rational part of a deficient leaf: the witnesses and the final test, given the hit
product `(hn, hd)`. With `S = Sn/Sd` and `U0 = H (x/(x - 1))^u ((x^2 + x + 1)/x^2)^(c + d) hn/hd`
the final test accepts either by the old path, `S < 1` and `U0/(1 - S) < 2`, or, when that
fails, by the Padé path, `S < 3` and `U0 (S^2 + 4 S + 6)/(6 - 2 S) < 2` (both in cross
multiplied form; each truncated subtraction is guarded by its first test). -/
def tailOK (P : Params) (ks : List Key) (x : ℕ) (dd : DefData) (b3 : ℕ) (cs3 : List (ℕ × ℕ))
    (hn hd : ℕ) : Bool :=
  let k := dd.k
  let B := dd.B
  let a := if qDec ks then 0 else 1
  let b := P.E - nexc ks
  let c := b3 - csum cs3
  let d := dCap ks + 2 * c
  let u := a + b
  let L := x * x + x + 1
  let M := max L P.MHIT
  let Gn := dd.rs.prod
  let Gd := (dd.rs.map (· - B)).prod
  let gxn := dd.rx ^ u
  let gxd := (dd.rx - B) ^ u
  let t1n := dd.mL.1 * Gn * (gxn - gxd)
  let t1d := dd.mL.2 * Gd * gxd
  let t2n := dd.mM.1 * Gn
  let t2d := dd.mM.2 * Gd
  let Rn := t1n * t2d + t2n * t1d
  let Rd := t1d * t2d
  let Sn := (x + 1) ^ 2 * Rn
  let Sd := x * x * Rd
  let H := hiProd P ks
  let cd := c + d
  decide (2 ≤ x) && decide (3 ≤ k) && decide (nexc ks ≤ P.E) && alphaOK k B (genK ks) dd.rs &&
    decide (B < dd.rx) && decide (dd.rx ^ k ≤ B ^ k * x) &&
    decide (0 < dd.mL.2) && decide (0 < dd.mM.2) &&
    decide (dd.mL.2 ^ (2 * k) ≤ dd.mL.1 ^ (2 * k) * L ^ (k - 2)) &&
    decide (dd.mM.2 ^ (2 * k) ≤ dd.mM.1 ^ (2 * k) * M ^ (k - 2)) &&
    ((decide (Sn < Sd) &&
      decide (H.1 * x ^ u * L ^ cd * hn * Sd <
        2 * (H.2 * (x - 1) ^ u * x ^ (2 * cd) * hd * (Sd - Sn)))) ||
     (decide (Sn < 3 * Sd) &&
      decide (H.1 * x ^ u * L ^ cd * hn * (Sn ^ 2 + 4 * Sn * Sd + 6 * Sd ^ 2) <
        2 * (H.2 * (x - 1) ^ u * x ^ (2 * cd) * hd * (6 * Sd ^ 2 - 2 * Sn * Sd)))))

/-- The budget of 3, its exponent, read from its role: 2 for a square, `kmin` for an exact
exception; none otherwise. -/
def budget3 : Role → Option ℕ
  | .sq => some 2
  | .fr false _ _ kmin true => some kmin
  | _ => none

/-- The deficient leaf at `x` (rule 6 with the tail bound). -/
def deficientB (P : Params) (ks : List Key) (x : ℕ) (dd : DefData) : Bool :=
  match findKey 3 ks with
  | some ⟨_, r3, cs3⟩ =>
    match budget3 r3 with
    | some b3 =>
      match enumG P.MHIT (visit ks x dd.comps) (genK ks) 1 (true, 1, 1) with
      | (ok, hn, hd) => ok && tailOK P ks x dd b3 cs3 hn hd
    | none => false
  | none => false

/-! ## The checker -/

/-- What the checker expects at a node. -/
inductive Ctx where
  /-- An `apply` record with component `c`, before its items. -/
  | apply (ks : List Key) (x : ℕ) (pend : List (ℕ × ℕ × ℕ)) (c : ℕ) : Ctx
  /-- The outcome of a record after its items. -/
  | out (ks : List Key) (x : ℕ) (pend : List (ℕ × ℕ × ℕ)) : Ctx
  /-- A chain of role children of the prime `f` with contributions `cs`, roles `rs` left. -/
  | roles (ks : List Key) (x : ℕ) (pend : List (ℕ × ℕ × ℕ)) (f : ℕ) (cs : List (ℕ × ℕ))
      (rs : List Role) : Ctx
  /-- A chain of sender entries for the receiver `p`, free primes `gs` left. -/
  | senders (ks : List Key) (x : ℕ) (p : ℕ) (gs : List ℕ) : Ctx
  /-- One sender entry for the receiver `p` and the free prime `g`. -/
  | sender (ks : List Key) (x : ℕ) (p g : ℕ) : Ctx
  /-- A step: decide, check, split or a reference to a state refuted elsewhere. -/
  | step (ks : List Key) (x : ℕ) : Ctx

/-- The checker. `pr` is a primality oracle and `done` recognizes states refuted elsewhere;
the soundness theorem assumes both are sound. -/
def go (P : Params) (pr : ℕ → Bool) (done : List Key → ℕ → Bool) : Ctx → Cert → Bool
  | .apply ks x pend c, .apply items out =>
    match applyItems pr x c items ks pend with
    | .rej => false
    | .contra => true
    | .ok ks' pend' => go P pr done (.out ks' x pend') out
  | .out ks _ _, .abundant => abundantB P ks
  | .out ks x _, .landedL => landedLB P ks x
  | .out ks x pend, .force ch =>
    let f := pmin pend
    !pend.isEmpty && pr f && f % 2 == 1 && !isKey ks f &&
      go P pr done (.roles ks x (pend.filter (·.1 != f)) f (csOf f pend) (rolesOf P ks f)) ch
  | .out ks x _, .receipt p ss =>
    qDec ks && nexc ks == P.E && isKey ks p && p % 3 == 2 &&
      go P pr done (.senders ks x p (freeOthers ks p)) ss
  | .out ks x _, .closed s => go P pr done (.step ks x) s
  | .roles _ _ _ _ _ rs, .nil => rs.isEmpty
  | .roles ks x pend f cs rs, .cons hd tl =>
    match rs with
    | [] => false
    | r :: rs' =>
      go P pr done (.apply (insertKey ⟨f, r, cs⟩ ks) x pend f) hd &&
        go P pr done (.roles ks x pend f cs rs') tl
  | .senders _ _ _ gs, .nil => gs.isEmpty
  | .senders ks x p gs, .cons hd tl =>
    match gs with
    | [] => false
    | g :: gs' => go P pr done (.sender ks x p g) hd && go P pr done (.senders ks x p gs') tl
  | .sender ks _ p g, .inf g' d =>
    g == g' && match findKey g ks with
      | some k => ordOK d g p && infeasibleB k.role d
      | none => false
  | .sender ks x p g, .snd g' d child =>
    g == g' && match findKey g ks with
      | some ⟨_, .fr isQ D no3 kmin ex, _⟩ =>
        ordOK d g p &&
          (let L := Nat.lcm D d
           if ex then (kmin + 1) % L == 0 && go P pr done (.apply ks x [] g) child
           else match nextAllowed isQ L no3 (kmin + 1) with
             | some n => go P pr done (.apply (setRole g (.fr isQ L no3 (n - 1) false) ks) x [] g) child
             | none => false)
      | _ => false
  | .step ks x, .decide ch ab =>
    match scanNext ks x with
    | some y => go P pr done (.roles ks y [] y [] (rolesOf P ks y)) ch && go P pr done (.step ks (y + 1)) ab
    | none => false
  | .step ks x, .check dd =>
    match scanNext ks x with
    | some y => deficientB P ks y dd
    | none => false
  | .step ks x, .checkL =>
    match scanNext ks x with
    | some y => landedLB P ks y
    | none => false
  | .step ks x, .split p ex atl =>
    match findKey p ks with
    | some ⟨_, .fr isQ D no3 kmin false, _⟩ =>
      go P pr done (.apply (setRole p (.fr isQ (kmin + 1) no3 kmin true) ks) x [] p) ex &&
        match nextAllowed isQ D no3 (kmin + 2) with
        | some n => go P pr done (.apply (setRole p (.fr isQ D no3 (n - 1) false) ks) x [] p) atl
        | none => false
    | _ => false
  | .step ks x, .ext => done ks x
  | _, _ => false

/-- The root state: `3` is a square key with no contributions, and `x = 5` (`2 ∤ N`). -/
def rootKeys : List Key := [⟨3, .sq, []⟩]

/-- Check a certificate from the root record (the row of `3`, component `3`), for the family
with exponent 2 at 3 and no exponent condition on the exceptions. -/
def check (P : Params) (pr : ℕ → Bool) (done : List Key → ℕ → Bool) (c : Cert) : Bool :=
  (P.V3 == 2 && !P.e4) && go P pr done (.apply rootKeys 5 [] 3) c

/-- The role of 3 at the root: a square when `V3 = 2`, otherwise an exception key of exact
exponent `V3`. -/
def root3 (P : Params) : Role := cond (P.V3 == 2) .sq (.fr false (P.V3 + 1) false P.V3 true)

/-- The root state for the parameters `P`: `3` is a key with the role `root3 P` and no
contributions. -/
def rootKeysV (P : Params) : List Key := [⟨3, root3 P, []⟩]

/-- The admissible exponents of 3: `2`, or an even number at least 4. -/
def paramsOK (P : Params) : Bool := P.V3 == 2 || (P.V3 % 2 == 0 && Nat.ble 4 P.V3)

/-- Check a certificate from the root record for the parameters `P`, any admissible `V3`. -/
def checkV (P : Params) (pr : ℕ → Bool) (done : List Key → ℕ → Bool) (c : Cert) : Bool :=
  paramsOK P && go P pr done (.apply (rootKeysV P) 5 [] 3) c

/-! ## A primality table -/

/-- A binary search tree of primes. -/
inductive PTree where
  | leaf : PTree
  | node (l : PTree) (p : ℕ) (r : PTree) : PTree
  deriving Repr

/-- Membership in a search tree. -/
def PTree.mem (n : ℕ) : PTree → Bool
  | .leaf => false
  | .node l p r => cond (Nat.beq n p) true (cond (Nat.blt n p) (l.mem n) (r.mem n))

/-- The elements of a tree. -/
def PTree.toList : PTree → List ℕ
  | .leaf => []
  | .node l p r => l.toList ++ p :: r.toList

end TwoExcEngine

