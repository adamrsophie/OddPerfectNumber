    Closed ([⟨3, 2, false⟩, ⟨5, 1, false⟩, ⟨17, 1, false⟩] ++ [⟨137, kmin 137, false⟩]) (3 - 1) 137 :=
  closed_of_split (pre := [⟨3, 2, false⟩]) (post := [⟨17, 1, false⟩, ⟨137, 1, false⟩]) (by decide) n3_5_17_137_1 n3_5_17_137_2

